<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>مصطفى نبيل | ماجستير علم النفس السريري</title>
    <link rel="stylesheet" href="/css/home.css">
    <script type="module" src="https://cdn.jsdelivr.net/npm/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://cdn.jsdelivr.net/npm/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
</head>

<body>

    <!-- ========== NAVBAR ========== -->
    <nav class="navbar">
        <div class="container">
            <a href="/" class="navbar-brand">
                <span class="dot">•</span>
                مصطفى نبيل
            </a>
            <div class="navbar-menu">
                <a href="#hero" class="nav-link">الرئيسية</a>
                <a href="#about" class="nav-link">من نحن</a>
                <a href="#services" class="nav-link">الخدمات</a>
                <a href="#courses" class="nav-link">الكورسات</a>
                <a href="#testimonials" class="nav-link">آراء العملاء</a>
                <a href="#faq" class="nav-link">الأسئلة الشائعة</a>
                <a href="#reservation" class="nav-link">حجز موعد</a>
            </div>
        </div>
    </nav>

    <!-- ========== HERO SECTION ========== -->
    <section id="hero" class="hero-section">
        <div class="container">
            <!-- Hero Content -->
            <div class="hero-content">
                <p class="hero-greeting">أهلاً بك، أنا</p>
                <h1 class="hero-name"><span class="highlight">مصطفى</span> نبيل</h1>
                <h2 class="hero-title">ماجستير <span class="profession">علم النفس السريري</span></h2>
                <p class="hero-university">جامعة عمان الأهلية</p>
                <p class="hero-description">
                    متخصص في العلاج النفسي والدعم النفسي للأفراد والأزواج والعائلات. أساعدك على التغلب على التحديات النفسية والعاطفية من خلال جلسات علاجية احترافية في بيئة آمنة ومريحة.
                </p>
                <div class="hero-actions">
                    <a href="#reservation" class="btn btn-primary">
                        احجز موعد
                    </a>
                    <a href="#courses" class="btn btn-secondary">
                        الكورسات
                    </a>
                </div>
                <div class="hero-social">
                    <a href="#" class="social-icon">
                        <ion-icon name="logo-facebook"></ion-icon>
                    </a>
                    <a href="#" class="social-icon">
                        <ion-icon name="logo-instagram"></ion-icon>
                    </a>
                    <a href="https://wa.me/9647XXXXXXXX" class="social-icon" target="_blank">
                        <ion-icon name="logo-whatsapp"></ion-icon>
                    </a>
                </div>
            </div>

            <!-- Hero Image -->
            <div class="hero-image-wrapper">
                <img src="/images/me.jpg" alt="مصطفى نبيل">
            </div>
        </div>
    </section>

    <!-- ========== ABOUT SECTION ========== -->
    <section id="about" class="about-section">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">الصحة النفسية</h2>
                <p class="section-subtitle">رعايتك النفسية أولويتنا</p>
            </div>

            <div class="about-content">
                <div class="about-card">
                    <div class="card-icon">
                        <ion-icon name="heart"></ion-icon>
                    </div>
                    <h3>ما هي الصحة النفسية؟</h3>
                    <p>
                        الصحة النفسية هي حالة من الرفاهية يدرك فيها الفقد قدراته الخاصة، ويمكنه التعامل مع ضغوط الحياة العادية، ويعمل بشكل منتظم ومفيد للمجتمع.
                    </p>
                </div>

                <div class="about-card">
                    <div class="card-icon">
                        <ion-icon name="bulb"></ion-icon>
                    </div>
                    <h3>أهمية الرعاية النفسية</h3>
                    <p>
                        العناية بالصحة النفسية ضرورية للتمتع بحياة متوازنة ومنتجة. نقدم لك الدعم والإرشاد اللازم للتغلب على التحديات النفسية والعاطفية.
                    </p>
                </div>

                <div class="about-card">
                    <div class="card-icon">
                        <ion-icon name="shield-checkmark"></ion-icon>
                    </div>
                    <h3>طرق العلاج</h3>
                    <p>
                        نستخدم أحدث طرق العلاج النفسي المبنية على الأدلة العلمية، مع مراعاة الخصوصية والسرية التامة لجميع مرضانا.
                    </p>
                </div>
            </div>

            <div class="tips-section">
                <h3 class="tips-title">نصائح للصحة النفسية</h3>
                <div class="tips-grid">
                    <div class="tip-item">
                        <ion-icon name="checkmark-circle"></ion-icon>
                        <span>ممارسة الرياضة بانتظام</span>
                    </div>
                    <div class="tip-item">
                        <ion-icon name="checkmark-circle"></ion-icon>
                        <span>الحصول على قسط كافٍ من النوم</span>
                    </div>
                    <div class="tip-item">
                        <ion-icon name="checkmark-circle"></ion-icon>
                        <span>التحدث مع شخص تثق به</span>
                    </div>
                    <div class="tip-item">
                        <ion-icon name="checkmark-circle"></ion-icon>
                        <span>تخصيص وقت للراحة والاسترخاء</span>
                    </div>
                    <div class="tip-item">
                        <ion-icon name="checkmark-circle"></ion-icon>
                        <span>تجنب المواد الضارة</span>
                    </div>
                    <div class="tip-item">
                        <ion-icon name="checkmark-circle"></ion-icon>
                        <span>طلب المساعدة عند الحاجة</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ========== STATS SECTION ========== -->
    <section class="stats-section">
        <div class="container">
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon">
                        <ion-icon name="people"></ion-icon>
                    </div>
                    <div class="stat-content">
                        <h3 class="stat-number"><%= totalPatients || 0 %>+</h3>
                        <p class="stat-label">مريض سعيد</p>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon">
                        <ion-icon name="pulse"></ion-icon>
                    </div>
                    <div class="stat-content">
                        <h3 class="stat-number"><%= activePatients || 0 %></h3>
                        <p class="stat-label">مرضى نشطين</p>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon">
                        <ion-icon name="trophy"></ion-icon>
                    </div>
                    <div class="stat-content">
                        <h3 class="stat-number">5+</h3>
                        <p class="stat-label">سنوات خبرة</p>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon">
                        <ion-icon name="star"></ion-icon>
                    </div>
                    <div class="stat-content">
                        <h3 class="stat-number">98%</h3>
                        <p class="stat-label">نسبة الرضا</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ========== SERVICES SECTION ========== -->
    <section id="services" class="services-section">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">الخدمات المقدمة</h2>
                <p class="section-subtitle">نقدم لك أفضل الخدمات العلاجية</p>
            </div>

            <div class="services-grid">
                <div class="service-card">
                    <div class="service-icon">
                        <ion-icon name="heart-half"></ion-icon>
                    </div>
                    <h3>علاج الاكتئاب</h3>
                    <p>أساعدك على التغلب على الاكتئاب من خلال جلسات علاجية مخصصة وفعالة.</p>
                </div>

                <div class="service-card">
                    <div class="service-icon">
                        <ion-icon name="thunderstorm"></ion-icon>
                    </div>
                    <h3>علاج القلق والتوتر</h3>
                    <p>علاج اضطرابات القلق المختلفة بما في ذلك القلق الاجتماعي والنوبات الذعر.</p>
                </div>

                <div class="service-card">
                    <div class="service-icon">
                        <ion-icon name="infinite"></ion-icon>
                    </div>
                    <h3>الوسواس القهري (OCD)</h3>
                    <p>علاج السلوكيات القهرية والأفكار الوسواسية باستخدام أحدث التقنيات.</p>
                </div>

                <div class="service-card">
                    <div class="service-icon">
                        <ion-icon name="people"></ion-icon>
                    </div>
                    <h3>العلاج الزوجي</h3>
                    <p>تحسين التواصل وحل المشكلات الزوجية من خلال جلسات العلاج الثنائي.</p>
                </div>

                <div class="service-card">
                    <div class="service-icon">
                        <ion-icon name="home"></ion-icon>
                    </div>
                    <h3>العلاج الأسري</h3>
                    <p>علاج المشكلات الأسرية وتحسين العلاقات بين أفراد العائلة.</p>
                </div>

                <div class="service-card">
                    <div class="service-icon">
                        <ion-icon name="medkit"></ion-icon>
                    </div>
                    <h3>اضطراب ما بعد الصدمة (PTSD)</h3>
                    <p>علاج الصدمات النفسية والتعافي من الأحداث المؤلمة.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ========== COURSES SECTION ========== -->
    <section id="courses" class="courses-section">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">الكورسات المتاحة</h2>
                <p class="section-subtitle">اختر الكورس المناسب لك</p>
            </div>

            <div class="courses-table-wrapper">
                <table class="courses-table">
                    <thead>
                        <tr>
                            <th>الكورس</th>
                            <th>عدد الجلسات</th>
                            <th>السعر</th>
                            <th>الإجراء</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (courses && courses.length > 0) { %>
                            <% courses.forEach((course, index) => { %>
                                <tr>
                                    <td>كورس <%= index + 1 %></td>
                                    <td><%= course.sessions || 0 %> جلسة</td>
                                    <td><%= course.price || 0 %> دينار</td>
                                    <td>
                                        <a href="#reservation" class="btn btn-outline" style="padding: 8px 20px; font-size: 13px;">احجز الآن</a>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="4" class="text-center">لا توجد كورسات متاحة حالياً</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <!-- ========== FAQ SECTION ========== -->
    <section id="faq" class="faq-section">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">الأسئلة الشائعة</h2>
                <p class="section-subtitle">إجابات على أكثر الأسئلة شيوعاً</p>
            </div>

            <div class="faq-grid">
                <div class="faq-item">
                    <div class="faq-question">
                        <ion-icon name="help-circle"></ion-icon>
                        <h3>كم مدة الجلسة العلاجية؟</h3>
                    </div>
                    <div class="faq-answer">
                        <p>تستمر الجلسة العلاجية عادة ما بين 45-60 دقيقة، حسب نوع العلاج واحتياجات المريض.</p>
                    </div>
                </div>

                <div class="faq-item">
                    <div class="faq-question">
                        <ion-icon name="help-circle"></ion-icon>
                        <h3>ما هو سعر الجلسة؟</h3>
                    </div>
                    <div class="faq-answer">
                        <p>يختلف سعر الجلسة حسب نوع العلاج والكورس المختار. يرجى مراجعة قسم الكورسات لمعرفة الأسعار.</p>
                    </div>
                </div>

                <div class="faq-item">
                    <div class="faq-question">
                        <ion-icon name="help-circle"></ion-icon>
                        <h3>هل الجلسات سرية ومحمية؟</h3>
                    </div>
                    <div class="faq-answer">
                        <p>نعم، نلتزم بالسرية التامة. جميع المعلومات التي تشاركها معنا محمية ولن يتم مشاركتها مع أي طرف ثالث.</p>
                    </div>
                </div>

                <div class="faq-item">
                    <div class="faq-question">
                        <ion-icon name="help-circle"></ion-icon>
                        <h3>ماذا يحدث في الجلسة الأولى؟</h3>
                    </div>
                    <div class="faq-answer">
                        <p>في الجلسة الأولى، نتعرف على بعضنا البعض ونناقش التحديات التي تواجهها. نقوم بتقييم حالتك وتحديد أهداف العلاج المناسبة لك.</p>
                    </div>
                </div>

                <div class="faq-item">
                    <div class="faq-question">
                        <ion-icon name="help-circle"></ion-icon>
                        <h3>هل تقدمون استشارات أونلاين؟</h3>
                    </div>
                    <div class="faq-answer">
                        <p>نعم، نقدم استشارات أونلاين عبر الفيديو للمريضين الذين لا يستطيعون الحضور شخصياً.</p>
                    </div>
                </div>

                <div class="faq-item">
                    <div class="faq-question">
                        <ion-icon name="help-circle"></ion-icon>
                        <h3>كم عدد الجلسات المطلوبة؟</h3>
                    </div>
                    <div class="faq-answer">
                        <p>يختلف عدد الجلسات من حالة لأخرى. بعد الجلسة الأولى، سنحدد معاً خطة علاجية وعدد الجلسات المناسبة لحالتك.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ========== LOCATION & HOURS SECTION ========== -->
    <section id="location" class="location-section">
        <div class="container">
            <div class="location-content">
                <div class="location-info">
                    <div class="section-header">
                        <h2 class="section-title">موقعنا وساعات العمل</h2>
                        <p class="section-subtitle">زورنا في العيادة أو تواصل معنا</p>
                    </div>

                    <div class="location-details">
                        <div class="location-item">
                            <div class="location-icon">
                                <ion-icon name="location"></ion-icon>
                            </div>
                            <div class="location-text">
                                <h4>العنوان</h4>
                                <p>العراق، الموصل، حي المصارف، جانب صيدلية رؤية</p>
                            </div>
                        </div>

                        <div class="location-item">
                            <div class="location-icon">
                                <ion-icon name="call"></ion-icon>
                            </div>
                            <div class="location-text">
                                <h4>الهاتف</h4>
                                <p dir="ltr">+964 7X XXX XXXX</p>
                            </div>
                        </div>

                        <div class="location-item">
                            <div class="location-icon">
                                <ion-icon name="mail"></ion-icon>
                            </div>
                            <div class="location-text">
                                <h4>البريد الإلكتروني</h4>
                                <p>info@mustafa-clinic.com</p>
                            </div>
                        </div>
                    </div>

                    <div class="working-hours">
                        <h4>ساعات العمل</h4>
                        <div class="hours-grid">
                            <div class="hours-item">
                                <span class="day">الأحد - الخميس</span>
                                <span class="time">9:00 ص - 8:00 م</span>
                            </div>
                            <div class="hours-item">
                                <span class="day">الجمعة</span>
                                <span class="time">مغلق</span>
                            </div>
                            <div class="hours-item">
                                <span class="day">السبت</span>
                                <span class="time">10:00 ص - 4:00 م</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="location-map">
                    <iframe
                        src="https://maps.google.com/maps?q=36.382781,43.180623&z=15&output=embed"
                        width="100%"
                        height="500"
                        style="border: 0; border-radius: var(--radius-md);"
                        allowfullscreen=""
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade">
                    </iframe>
                </div>
            </div>
        </div>
    </section>

    <!-- ========== RESERVATION SECTION ========== -->
    <section id="reservation" class="reservation-section">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">حجز موعد</h2>
                <p class="section-subtitle">احجز موعدك معنا الآن</p>
            </div>

            <div class="reservation-wrapper">
                <!-- Step Indicator -->
                <div class="reservation-steps">
                    <div class="step active" id="step1-indicator">
                        <div class="step-number">1</div>
                        <div class="step-label">المعلومات</div>
                    </div>
                    <div class="step-line"></div>
                    <div class="step" id="step2-indicator">
                        <div class="step-number">2</div>
                        <div class="step-label">التحقق</div>
                    </div>
                    <div class="step-line"></div>
                    <div class="step" id="step3-indicator">
                        <div class="step-number">3</div>
                        <div class="step-label">التأكيد</div>
                    </div>
                </div>

                <!-- Step 1: Information Form -->
                <form id="reservationForm" class="reservation-form">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="name">الاسم الكامل *</label>
                            <input type="text" id="name" name="name" required placeholder="أدخل اسمك الكامل">
                        </div>

                        <div class="form-group">
                            <label for="phone">رقم الهاتف *</label>
                            <input type="tel" id="phone" name="phone" required placeholder="07xxxxxxxx" pattern="^07[0-9]{9}$">
                            <small class="form-hint">سيتم إرسال رمز التحقق إلى هذا الرقم</small>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="birthDate">تاريخ الميلاد *</label>
                            <input type="date" id="birthDate" name="birthDate" required>
                        </div>

                        <div class="form-group">
                            <label for="gender">الجنس *</label>
                            <select id="gender" name="gender" required>
                                <option value="">اختر الجنس</option>
                                <option value="ذكر">ذكر</option>
                                <option value="أنثى">أنثى</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>نوع الاستشارة *</label>
                            <div class="radio-group">
                                <label class="radio-label">
                                    <input type="radio" name="type" value="حضوري" checked>
                                    <span>حضوري</span>
                                </label>
                                <label class="radio-label">
                                    <input type="radio" name="type" value="اونلاين">
                                    <span>اونلاين</span>
                                </label>
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="selectedDate">التاريخ المتاح *</label>
                            <select id="selectedDate" name="selectedDate" required>
                                <option value="">اختر التاريخ</option>
                                <% if (availableDates && availableDates.length > 0) { %>
                                    <% availableDates.forEach(date => { %>
                                        <option value="<%= date.date %>"><%= date.date %></option>
                                    <% }) %>
                                <% } else { %>
                                    <option value="" disabled>لا توجد مواعيد متاحة حالياً</option>
                                <% } %>
                            </select>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group full-width">
                            <label for="selectedTime">الموعد المتاح *</label>
                            <div class="time-slots-container" id="timeSlotsContainer">
                                <p class="time-slots-placeholder">اختر التاريخ أولاً لعرض المواعيد المتاحة</p>
                            </div>
                            <input type="hidden" id="selectedTime" name="selectedTime" required>
                        </div>
                    </div>

                    <div class="form-group full-width">
                        <label for="notes">ملاحظات إضافية</label>
                        <textarea id="notes" name="notes" rows="3" placeholder="أي ملاحظات تود إضافتها..."></textarea>
                    </div>

                    <div class="form-submit">
                        <button type="submit" class="btn btn-primary btn-large" id="sendOtpBtn">
                            <span class="btn-text">إرسال رمز التحقق</span>
                            <span class="btn-loader" style="display: none;">
                                <ion-icon name="sync" class="spin"></ion-icon>
                                جاري الإرسال...
                            </span>
                        </button>
                    </div>
                </form>

                <!-- Step 2: OTP Verification -->
                <div id="otpVerificationStep" class="otp-verification-step" style="display: none;">
                    <div class="otp-header">
                        <ion-icon name="phone-portrait-outline" class="otp-icon"></ion-icon>
                        <h3>التحقق من رقم الهاتف</h3>
                        <p>تم إرسال رمز التحقق إلى <span id="maskedPhone"></span></p>
                    </div>

                    <div class="otp-input-container">
                        <input type="text" class="otp-input" maxlength="1" data-index="0" inputmode="numeric">
                        <input type="text" class="otp-input" maxlength="1" data-index="1" inputmode="numeric">
                        <input type="text" class="otp-input" maxlength="1" data-index="2" inputmode="numeric">
                        <input type="text" class="otp-input" maxlength="1" data-index="3" inputmode="numeric">
                        <input type="text" class="otp-input" maxlength="1" data-index="4" inputmode="numeric">
                        <input type="text" class="otp-input" maxlength="1" data-index="5" inputmode="numeric">
                    </div>

                    <div class="otp-timer">
                        <span id="otpTimerText">صلاحية الرمز: </span>
                        <span id="otpCountdown">5:00</span>
                    </div>

                    <div class="otp-error" id="otpError" style="display: none;"></div>

                    <div class="otp-actions">
                        <button type="button" class="btn btn-primary btn-large" id="verifyOtpBtn">
                            <span class="btn-text">تأكيد الرمز</span>
                            <span class="btn-loader" style="display: none;">
                                <ion-icon name="sync" class="spin"></ion-icon>
                                جاري التحقق...
                            </span>
                        </button>
                        
                        <button type="button" class="btn btn-secondary" id="resendOtpBtn" disabled>
                            إعادة إرسال الرمز (<span id="resendCountdown">60</span>)
                        </button>

                        <button type="button" class="btn btn-link" id="changeInfoBtn">
                            تعديل المعلومات
                        </button>
                    </div>
                </div>

                <!-- Step 3: Success -->
                <div id="successStep" class="success-step" style="display: none;">
                    <div class="success-icon">
                        <ion-icon name="checkmark-circle"></ion-icon>
                    </div>
                    <h3>تم تأكيد الحجز بنجاح!</h3>
                    <div class="reservation-summary">
                        <div class="summary-item">
                            <ion-icon name="person"></ion-icon>
                            <span id="summaryName"></span>
                        </div>
                        <div class="summary-item">
                            <ion-icon name="calendar"></ion-icon>
                            <span id="summaryDate"></span>
                        </div>
                        <div class="summary-item">
                            <ion-icon name="time"></ion-icon>
                            <span id="summaryTime"></span>
                        </div>
                        <div class="summary-item">
                            <ion-icon name="videocam"></ion-icon>
                            <span id="summaryType"></span>
                        </div>
                    </div>
                    <p class="success-message">سنتواصل معك قريباً لتأكيد الموعد. شكراً لثقتك بنا!</p>
                    <button type="button" class="btn btn-primary" id="newReservationBtn">
                        حجز موعد جديد
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- ========== FOOTER ========== -->
    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-brand">
                    <h3>عيادة مصطفى نبيل</h3>
                    <p>رعايتك النفسية أولويتنا</p>
                </div>

                <div class="footer-links">
                    <h4>روابط سريعة</h4>
                    <a href="#hero">الرئيسية</a>
                    <a href="#about">من نحن</a>
                    <a href="#services">الخدمات</a>
                    <a href="#courses">الكورسات</a>
                    <a href="#testimonials">آراء العملاء</a>
                    <a href="#reservation">حجز موعد</a>
                </div>

                <div class="footer-contact">
                    <h4>تواصل معنا</h4>
                    <p><ion-icon name="call"></ion-icon> 07xxxxxxxx</p>
                    <p><ion-icon name="mail"></ion-icon> info@mustafa-clinic.com</p>
                    <div class="social-links">
                        <a href="#"><ion-icon name="logo-facebook"></ion-icon></a>
                        <a href="#"><ion-icon name="logo-instagram"></ion-icon></a>
                        <a href="https://wa.me/9647XXXXXXXX"><ion-icon name="logo-whatsapp"></ion-icon></a>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2026 عيادة مصطفى نبيل. جميع الحقوق محفوظة.</p>
            </div>
        </div>
    </footer>

    <!-- ========== JAVASCRIPT ========== -->
    <script>
        // Smooth scroll for navigation links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });

        // ========== RESERVATION SYSTEM ==========
        const reservationForm = document.getElementById('reservationForm');
        const otpVerificationStep = document.getElementById('otpVerificationStep');
        const successStep = document.getElementById('successStep');
        const dateSelect = document.getElementById('selectedDate');
        const timeSlotsContainer = document.getElementById('timeSlotsContainer');
        const selectedTimeInput = document.getElementById('selectedTime');

        let currentReservationId = null;
        let otpTimer = null;
        let resendTimer = null;

        // Step indicators
        const step1 = document.getElementById('step1-indicator');
        const step2 = document.getElementById('step2-indicator');
        const step3 = document.getElementById('step3-indicator');

        function setActiveStep(stepNum) {
            [step1, step2, step3].forEach((step, idx) => {
                step.classList.remove('active', 'completed');
                if (idx + 1 < stepNum) step.classList.add('completed');
                if (idx + 1 === stepNum) step.classList.add('active');
            });
        }

        // Fetch available time slots when date changes
        dateSelect.addEventListener('change', async function() {
            const selectedDate = this.value;
            selectedTimeInput.value = '';
            
            if (!selectedDate) {
                timeSlotsContainer.innerHTML = '<p class="time-slots-placeholder">اختر التاريخ أولاً لعرض المواعيد المتاحة</p>';
                return;
            }

            timeSlotsContainer.innerHTML = '<p class="time-slots-loading"><ion-icon name="sync" class="spin"></ion-icon> جاري تحميل المواعيد...</p>';

            try {
                const response = await fetch(`/reservation/available-slots?date=${encodeURIComponent(selectedDate)}`);
                const data = await response.json();

                if (data.success && data.slots && data.slots.length > 0) {
                    timeSlotsContainer.innerHTML = data.slots.map(slot => `
                        <button type="button" class="time-slot-btn" data-time="${slot}">
                            ${slot}
                        </button>
                    `).join('');

                    // Add click handlers
                    document.querySelectorAll('.time-slot-btn').forEach(btn => {
                        btn.addEventListener('click', function() {
                            document.querySelectorAll('.time-slot-btn').forEach(b => b.classList.remove('selected'));
                            this.classList.add('selected');
                            selectedTimeInput.value = this.dataset.time;
                        });
                    });
                } else {
                    timeSlotsContainer.innerHTML = '<p class="time-slots-empty">لا توجد مواعيد متاحة لهذا التاريخ</p>';
                }
            } catch (error) {
                console.error('Error fetching slots:', error);
                timeSlotsContainer.innerHTML = '<p class="time-slots-error">خطأ في تحميل المواعيد</p>';
            }
        });

        // Send OTP on form submit
        reservationForm.addEventListener('submit', async function(e) {
            e.preventDefault();

            if (!selectedTimeInput.value) {
                alert('يرجى اختيار الموعد');
                return;
            }

            const formData = new FormData(this);
            const data = Object.fromEntries(formData);

            const btn = document.getElementById('sendOtpBtn');
            const btnText = btn.querySelector('.btn-text');
            const btnLoader = btn.querySelector('.btn-loader');

            btnText.style.display = 'none';
            btnLoader.style.display = 'inline-flex';
            btn.disabled = true;

            try {
                const response = await fetch('/reservation/send-otp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                const result = await response.json();

                if (result.success) {
                    currentReservationId = result.reservationId;
                    
                    // Show OTP step
                    reservationForm.style.display = 'none';
                    otpVerificationStep.style.display = 'block';
                    setActiveStep(2);

                    // Mask phone number
                    const phone = data.phone;
                    document.getElementById('maskedPhone').textContent = 
                        phone.substring(0, 3) + '****' + phone.substring(phone.length - 3);

                    // Start timers
                    startOtpTimer(result.expiresIn || 300);
                    startResendTimer(60);

                    // Focus first OTP input
                    document.querySelector('.otp-input').focus();
                } else {
                    alert(result.message || 'حدث خطأ. يرجى المحاولة مرة أخرى.');
                }
            } catch (error) {
                console.error('Error:', error);
                alert('حدث خطأ في الاتصال. يرجى المحاولة مرة أخرى.');
            } finally {
                btnText.style.display = 'inline';
                btnLoader.style.display = 'none';
                btn.disabled = false;
            }
        });

        // OTP Input handling
        document.querySelectorAll('.otp-input').forEach((input, idx, inputs) => {
            input.addEventListener('input', function(e) {
                const value = e.target.value;
                if (value && idx < inputs.length - 1) {
                    inputs[idx + 1].focus();
                }
                // Auto-submit when all filled
                const otpCode = Array.from(inputs).map(i => i.value).join('');
                if (otpCode.length === 6) {
                    document.getElementById('verifyOtpBtn').click();
                }
            });

            input.addEventListener('keydown', function(e) {
                if (e.key === 'Backspace' && !this.value && idx > 0) {
                    inputs[idx - 1].focus();
                }
            });

            input.addEventListener('paste', function(e) {
                e.preventDefault();
                const paste = (e.clipboardData || window.clipboardData).getData('text');
                const digits = paste.replace(/\D/g, '').substring(0, 6);
                digits.split('').forEach((digit, i) => {
                    if (inputs[i]) inputs[i].value = digit;
                });
                if (digits.length === 6) {
                    document.getElementById('verifyOtpBtn').click();
                }
            });
        });

        // Verify OTP
        document.getElementById('verifyOtpBtn').addEventListener('click', async function() {
            const inputs = document.querySelectorAll('.otp-input');
            const otpCode = Array.from(inputs).map(i => i.value).join('');

            if (otpCode.length !== 6) {
                showOtpError('يرجى إدخال رمز التحقق كاملاً');
                return;
            }

            const btn = this;
            const btnText = btn.querySelector('.btn-text');
            const btnLoader = btn.querySelector('.btn-loader');

            btnText.style.display = 'none';
            btnLoader.style.display = 'inline-flex';
            btn.disabled = true;

            try {
                const response = await fetch('/reservation/verify-otp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        reservationId: currentReservationId,
                        otpCode: otpCode
                    })
                });

                const result = await response.json();

                if (result.success) {
                    // Clear timers
                    clearInterval(otpTimer);
                    clearInterval(resendTimer);

                    // Show success step
                    otpVerificationStep.style.display = 'none';
                    successStep.style.display = 'block';
                    setActiveStep(3);

                    // Fill summary
                    document.getElementById('summaryName').textContent = result.reservation.name;
                    document.getElementById('summaryDate').textContent = result.reservation.date;
                    document.getElementById('summaryTime').textContent = result.reservation.time;
                    document.getElementById('summaryType').textContent = result.reservation.type;
                } else {
                    showOtpError(result.message || 'رمز التحقق غير صحيح');
                    
                    if (result.expired || result.maxAttemptsReached) {
                        // Reset to form
                        setTimeout(() => {
                            resetReservation();
                        }, 2000);
                    }
                }
            } catch (error) {
                console.error('Error:', error);
                showOtpError('حدث خطأ في الاتصال');
            } finally {
                btnText.style.display = 'inline';
                btnLoader.style.display = 'none';
                btn.disabled = false;
            }
        });

        // Resend OTP
        document.getElementById('resendOtpBtn').addEventListener('click', async function() {
            if (this.disabled) return;

            this.disabled = true;

            try {
                const response = await fetch('/reservation/resend-otp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ reservationId: currentReservationId })
                });

                const result = await response.json();

                if (result.success) {
                    // Clear old inputs
                    document.querySelectorAll('.otp-input').forEach(i => i.value = '');
                    document.querySelector('.otp-input').focus();
                    
                    // Reset timers
                    startOtpTimer(result.expiresIn || 300);
                    startResendTimer(60);
                    
                    hideOtpError();
                } else {
                    showOtpError(result.message);
                    if (result.remainingSeconds) {
                        startResendTimer(result.remainingSeconds);
                    }
                }
            } catch (error) {
                console.error('Error:', error);
                showOtpError('حدث خطأ في إعادة الإرسال');
            }
        });

        // Change info button
        document.getElementById('changeInfoBtn').addEventListener('click', resetReservation);

        // New reservation button
        document.getElementById('newReservationBtn').addEventListener('click', function() {
            resetReservation();
            // Scroll to reservation section
            document.getElementById('reservation').scrollIntoView({ behavior: 'smooth' });
        });

        function resetReservation() {
            clearInterval(otpTimer);
            clearInterval(resendTimer);
            currentReservationId = null;

            reservationForm.reset();
            reservationForm.style.display = 'block';
            otpVerificationStep.style.display = 'none';
            successStep.style.display = 'none';
            
            timeSlotsContainer.innerHTML = '<p class="time-slots-placeholder">اختر التاريخ أولاً لعرض المواعيد المتاحة</p>';
            selectedTimeInput.value = '';
            
            document.querySelectorAll('.otp-input').forEach(i => i.value = '');
            hideOtpError();
            setActiveStep(1);
        }

        function startOtpTimer(seconds) {
            clearInterval(otpTimer);
            const countdown = document.getElementById('otpCountdown');
            
            let remaining = seconds;
            updateTimerDisplay(countdown, remaining);

            otpTimer = setInterval(() => {
                remaining--;
                updateTimerDisplay(countdown, remaining);
                
                if (remaining <= 0) {
                    clearInterval(otpTimer);
                    showOtpError('انتهت صلاحية رمز التحقق');
                }
            }, 1000);
        }

        function startResendTimer(seconds) {
            clearInterval(resendTimer);
            const btn = document.getElementById('resendOtpBtn');
            const countdown = document.getElementById('resendCountdown');
            
            let remaining = seconds;
            btn.disabled = true;
            countdown.textContent = remaining;

            resendTimer = setInterval(() => {
                remaining--;
                countdown.textContent = remaining;
                
                if (remaining <= 0) {
                    clearInterval(resendTimer);
                    btn.disabled = false;
                    btn.innerHTML = 'إعادة إرسال الرمز';
                }
            }, 1000);
        }

        function updateTimerDisplay(element, seconds) {
            const mins = Math.floor(seconds / 60);
            const secs = seconds % 60;
            element.textContent = `${mins}:${secs.toString().padStart(2, '0')}`;
        }

        function showOtpError(message) {
            const errorDiv = document.getElementById('otpError');
            errorDiv.textContent = message;
            errorDiv.style.display = 'block';
        }

        function hideOtpError() {
            document.getElementById('otpError').style.display = 'none';
        }

        // Navbar scroll effect
        window.addEventListener('scroll', function() {
            const navbar = document.querySelector('.navbar');
            if (window.scrollY > 50) {
                navbar.classList.add('scrolled');
            } else {
                navbar.classList.remove('scrolled');
            }
        });
    </script>

</body>

</html>
