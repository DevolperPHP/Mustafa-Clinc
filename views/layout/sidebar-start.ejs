<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-4Q6Gf2aSP4eDXB8Miphtr37CMZZQ5oXLH2yaXMJ2w8e2ZtHTl7GptT4jmndRuHDT" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-j1CDi7MgGQ12Z7Qab0qlWQ/Qqz24Gc6BM0thvEMVjHnfYGF0rmFCozFSxQBxwHKO"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script type="module" src="https://cdn.jsdelivr.net/npm/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://cdn.jsdelivr.net/npm/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
    <title>عيادة مصطفى نبيل</title>

    <style>
        :root {
            --primary: #22C55E;
            --primary-dark: #16A34A;
            --success: #22C55E;
            --warning: #FF9500;
            --danger: #FF3B30;
            --purple: #AF52DE;
            --sidebar-width: 260px;
            --sidebar-collapsed: 72px;
            --topbar-height: 64px;
            --gray-25: #FCFCFD;
            --gray-50: #F9FAFB;
            --gray-100: #F3F4F6;
            --gray-200: #E5E7EB;
            --gray-300: #D1D5DB;
            --gray-400: #9CA3AF;
            --gray-500: #6B7280;
            --gray-600: #4B5563;
            --gray-700: #374151;
            --gray-800: #1F2937;
            --gray-900: #111827;
            --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.04);
            --shadow-md: 0 4px 12px 0 rgb(0 0 0 / 0.08);
            --shadow-lg: 0 12px 24px 0 rgb(0 0 0 / 0.12);
            --radius-sm: 8px;
            --radius-md: 12px;
            --radius-lg: 16px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI", "Tajawal", sans-serif;
            background: var(--gray-50);
            min-height: 100vh;
            direction: rtl;
            color: var(--gray-800);
        }

        /* ========== SIDEBAR ========== */
        .sidebar {
            position: fixed;
            top: 0;
            right: 0;
            width: var(--sidebar-width);
            height: 100vh;
            background: white;
            border-left: 1px solid var(--gray-200);
            display: flex;
            flex-direction: column;
            z-index: 100;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .sidebar.collapsed {
            width: var(--sidebar-collapsed);
        }

        .sidebar-header {
            padding: 20px;
            border-bottom: 1px solid var(--gray-100);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .sidebar-logo {
            width: 40px;
            height: 40px;
            border-radius: var(--radius-md);
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .sidebar-logo ion-icon {
            font-size: 22px;
            color: white;
        }

        .sidebar-brand {
            display: flex;
            flex-direction: column;
            overflow: hidden;
            transition: opacity 0.2s;
        }

        .sidebar.collapsed .sidebar-brand {
            opacity: 0;
            width: 0;
        }

        .sidebar-brand-name {
            font-size: 15px;
            font-weight: 700;
            color: var(--gray-900);
            white-space: nowrap;
        }

        .sidebar-brand-sub {
            font-size: 11px;
            color: var(--gray-500);
            white-space: nowrap;
        }

        /* Sidebar Navigation */
        .sidebar-nav {
            flex: 1;
            overflow-y: auto;
            padding: 12px;
        }

        .sidebar-nav::-webkit-scrollbar {
            width: 4px;
        }

        .sidebar-nav::-webkit-scrollbar-track {
            background: transparent;
        }

        .sidebar-nav::-webkit-scrollbar-thumb {
            background: var(--gray-300);
            border-radius: 4px;
        }

        .nav-section {
            margin-bottom: 24px;
        }

        .nav-section-title {
            font-size: 11px;
            font-weight: 600;
            color: var(--gray-400);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 8px 12px;
            margin-bottom: 4px;
        }

        .sidebar.collapsed .nav-section-title {
            opacity: 0;
            height: 0;
            padding: 0;
            margin: 0;
            overflow: hidden;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px;
            border-radius: var(--radius-md);
            color: var(--gray-600);
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.2s;
            margin-bottom: 4px;
            position: relative;
        }

        .nav-item:hover {
            background: var(--gray-100);
            color: var(--gray-900);
        }

        .nav-item.active {
            background: rgba(34, 197, 94, 0.1);
            color: var(--primary);
        }

        .nav-item.active::before {
            content: '';
            position: absolute;
            right: 0;
            top: 50%;
            transform: translateY(-50%);
            width: 3px;
            height: 24px;
            background: var(--primary);
            border-radius: 0 3px 3px 0;
        }

        .nav-item ion-icon {
            font-size: 20px;
            flex-shrink: 0;
        }

        .nav-item span {
            white-space: nowrap;
            overflow: hidden;
            transition: opacity 0.2s;
        }

        .sidebar.collapsed .nav-item span {
            opacity: 0;
            width: 0;
        }

        .sidebar.collapsed .nav-item {
            justify-content: center;
            padding: 12px 8px;
        }

        /* Nav Item Badge */
        .nav-badge {
            margin-right: auto;
            padding: 2px 8px;
            border-radius: 10px;
            font-size: 11px;
            font-weight: 600;
            background: var(--primary);
            color: white;
        }

        .sidebar.collapsed .nav-badge {
            display: none;
        }

        /* Sidebar Footer */
        .sidebar-footer {
            padding: 16px;
            border-top: 1px solid var(--gray-100);
        }

        .sidebar-user {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px;
            border-radius: var(--radius-md);
            background: var(--gray-50);
        }

        .sidebar-user-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 16px;
            flex-shrink: 0;
        }

        .sidebar-user-info {
            overflow: hidden;
            transition: opacity 0.2s;
        }

        .sidebar.collapsed .sidebar-user-info {
            opacity: 0;
            width: 0;
        }

        .sidebar-user-name {
            font-size: 14px;
            font-weight: 600;
            color: var(--gray-900);
            white-space: nowrap;
        }

        .sidebar-user-role {
            font-size: 12px;
            color: var(--gray-500);
            white-space: nowrap;
        }

        .logout-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: 100%;
            padding: 10px;
            margin-top: 12px;
            border: none;
            border-radius: var(--radius-md);
            background: #FEE2E2;
            color: #DC2626;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
            text-decoration: none;
        }

        .logout-btn:hover {
            background: #FECACA;
            color: #DC2626;
        }

        .sidebar.collapsed .logout-btn span {
            display: none;
        }

        /* ========== TOPBAR ========== */
        .topbar {
            position: fixed;
            top: 0;
            right: var(--sidebar-width);
            left: 0;
            height: var(--topbar-height);
            background: white;
            border-bottom: 1px solid var(--gray-200);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 24px;
            z-index: 99;
            transition: right 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        body.sidebar-collapsed .topbar {
            right: var(--sidebar-collapsed);
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .sidebar-toggle {
            width: 40px;
            height: 40px;
            border: none;
            border-radius: var(--radius-md);
            background: var(--gray-100);
            color: var(--gray-600);
            font-size: 20px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
        }

        .sidebar-toggle:hover {
            background: var(--gray-200);
            color: var(--gray-900);
        }

        .page-title {
            font-size: 18px;
            font-weight: 700;
            color: var(--gray-900);
        }

        .topbar-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .topbar-search {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 16px;
            background: var(--gray-100);
            border-radius: var(--radius-md);
            cursor: pointer;
            transition: all 0.2s;
        }

        .topbar-search:hover {
            background: var(--gray-200);
        }

        .topbar-search ion-icon {
            font-size: 18px;
            color: var(--gray-500);
        }

        .topbar-search span {
            font-size: 14px;
            color: var(--gray-400);
        }

        .topbar-search kbd {
            padding: 2px 6px;
            background: white;
            border-radius: 4px;
            font-size: 11px;
            color: var(--gray-500);
            border: 1px solid var(--gray-200);
        }

        .add-patient-btn {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 20px;
            border: none;
            border-radius: var(--radius-md);
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            color: white;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.2s;
        }

        .add-patient-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(34, 197, 94, 0.3);
            color: white;
        }

        /* ========== MAIN CONTENT ========== */
        .main-content {
            margin-right: var(--sidebar-width);
            margin-top: var(--topbar-height);
            min-height: calc(100vh - var(--topbar-height));
            padding: 24px;
            transition: margin-right 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        body.sidebar-collapsed .main-content {
            margin-right: var(--sidebar-collapsed);
        }

        /* ========== SEARCH MODAL ========== */
        .search-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(8px);
            z-index: 200;
            align-items: flex-start;
            justify-content: center;
            padding-top: 100px;
        }

        .search-modal.show {
            display: flex;
        }

        .search-container {
            background: white;
            border-radius: var(--radius-lg);
            padding: 20px;
            width: 90%;
            max-width: 600px;
            box-shadow: var(--shadow-lg);
        }

        .search-input-wrapper {
            position: relative;
        }

        .search-input {
            width: 100%;
            padding: 14px 48px;
            border: 2px solid var(--gray-200);
            border-radius: var(--radius-md);
            font-size: 16px;
            font-family: inherit;
            direction: rtl;
        }

        .search-input:focus {
            outline: none;
            border-color: var(--primary);
        }

        .search-input-icon {
            position: absolute;
            right: 16px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 20px;
            color: var(--gray-400);
        }

        .search-results {
            margin-top: 16px;
            max-height: 400px;
            overflow-y: auto;
        }

        .search-result-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px;
            border-radius: var(--radius-md);
            cursor: pointer;
            transition: all 0.15s;
        }

        .search-result-item:hover {
            background: var(--gray-100);
        }

        .search-result-icon {
            width: 40px;
            height: 40px;
            border-radius: var(--radius-sm);
            background: var(--gray-100);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--gray-500);
        }

        .search-result-info h4 {
            font-size: 15px;
            font-weight: 600;
            color: var(--gray-900);
        }

        .search-result-info p {
            font-size: 13px;
            color: var(--gray-500);
        }

        /* ========== MOBILE RESPONSIVE ========== */
        @media (max-width: 1024px) {
            .sidebar {
                right: -100%;
            }

            .sidebar.show {
                right: 0;
            }

            .topbar {
                right: 0;
            }

            .main-content {
                margin-right: 0;
            }

            body.sidebar-collapsed .topbar,
            body.sidebar-collapsed .main-content {
                right: 0;
                margin-right: 0;
            }

            .mobile-overlay {
                display: none;
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: rgba(0, 0, 0, 0.5);
                z-index: 99;
            }

            .mobile-overlay.show {
                display: block;
            }

            .topbar-search span,
            .topbar-search kbd {
                display: none;
            }
        }

        @media (max-width: 640px) {
            .topbar {
                padding: 0 16px;
            }

            .main-content {
                padding: 16px;
            }

            .add-patient-btn span {
                display: none;
            }

            .add-patient-btn {
                padding: 10px;
            }
        }

        /* Tooltip for collapsed sidebar */
        .sidebar.collapsed .nav-item {
            position: relative;
        }

        .sidebar.collapsed .nav-item::after {
            content: attr(data-title);
            position: absolute;
            right: calc(100% + 10px);
            top: 50%;
            transform: translateY(-50%);
            padding: 6px 12px;
            background: var(--gray-900);
            color: white;
            font-size: 13px;
            border-radius: 6px;
            white-space: nowrap;
            opacity: 0;
            visibility: hidden;
            transition: all 0.2s;
            pointer-events: none;
        }

        .sidebar.collapsed .nav-item:hover::after {
            opacity: 1;
            visibility: visible;
        }
    </style>
</head>

<body>
    <!-- Mobile Overlay -->
    <div class="mobile-overlay" id="mobileOverlay" onclick="toggleSidebar()"></div>

    <!-- ========== SIDEBAR ========== -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <div class="sidebar-logo">
                <ion-icon name="medkit"></ion-icon>
            </div>
            <div class="sidebar-brand">
                <span class="sidebar-brand-name">عيادة مصطفى نبيل</span>
                <span class="sidebar-brand-sub">الاخصائي النفسي</span>
            </div>
        </div>

        <nav class="sidebar-nav">
            <div class="nav-section">
                <div class="nav-section-title">القائمة الرئيسية</div>
                <a href="/dashboard" class="nav-item <%= typeof page !== 'undefined' && page === 'dashboard' ? 'active' : '' %>" data-title="الرئيسية">
                    <ion-icon name="home"></ion-icon>
                    <span>الرئيسية</span>
                </a>
                <a href="/patient/history" class="nav-item <%= typeof page !== 'undefined' && page === 'patients' ? 'active' : '' %>" data-title="المرضى">
                    <ion-icon name="people"></ion-icon>
                    <span>المرضى</span>
                </a>
                <a href="/admin-reservations" class="nav-item <%= typeof page !== 'undefined' && page === 'reservations' ? 'active' : '' %>" data-title="الحجوزات">
                    <ion-icon name="calendar-number"></ion-icon>
                    <span>الحجوزات</span>
                </a>
                <a href="/analysis/daily/<%= typeof date !== 'undefined' ? date : new Date().toLocaleDateString('en-GB').split('/').join('/') %>" class="nav-item <%= typeof page !== 'undefined' && page === 'daily' ? 'active' : '' %>" data-title="الزيارات اليومية">
                    <ion-icon name="today"></ion-icon>
                    <span>الزيارات اليومية</span>
                </a>
            </div>

            <div class="nav-section">
                <div class="nav-section-title">المالية</div>
                <a href="/bills" class="nav-item <%= typeof page !== 'undefined' && page === 'bills' ? 'active' : '' %>" data-title="الحسابات">
                    <ion-icon name="card"></ion-icon>
                    <span>الحسابات</span>
                </a>
                <a href="/expenses" class="nav-item <%= typeof page !== 'undefined' && page === 'expenses' ? 'active' : '' %>" data-title="المصاريف">
                    <ion-icon name="cash"></ion-icon>
                    <span>المصاريف</span>
                </a>
                <a href="/analysis" class="nav-item <%= typeof page !== 'undefined' && page === 'analysis' ? 'active' : '' %>" data-title="التقارير">
                    <ion-icon name="analytics"></ion-icon>
                    <span>التقارير</span>
                </a>
            </div>

            <div class="nav-section">
                <div class="nav-section-title">العلاج</div>
                <a href="/course" class="nav-item <%= typeof page !== 'undefined' && page === 'courses' ? 'active' : '' %>" data-title="الكورسات">
                    <ion-icon name="layers"></ion-icon>
                    <span>الكورسات</span>
                </a>
                <a href="/tests" class="nav-item <%= typeof page !== 'undefined' && page === 'tests' ? 'active' : '' %>" data-title="الاختبارات">
                    <ion-icon name="extension-puzzle"></ion-icon>
                    <span>الاختبارات</span>
                </a>
                <a href="/exercise" class="nav-item <%= typeof page !== 'undefined' && page === 'exercises' ? 'active' : '' %>" data-title="التمارين">
                    <ion-icon name="barbell"></ion-icon>
                    <span>التمارين</span>
                </a>
            </div>

            <div class="nav-section">
                <div class="nav-section-title">الإعدادات</div>
                <a href="/admin-reservations/calendar" class="nav-item <%= typeof page !== 'undefined' && page === 'calendar' ? 'active' : '' %>" data-title="التقويم">
                    <ion-icon name="calendar"></ion-icon>
                    <span>تقويم المواعيد</span>
                </a>
                <a href="/fees" class="nav-item <%= typeof page !== 'undefined' && page === 'fees' ? 'active' : '' %>" data-title="الرسوم">
                    <ion-icon name="pricetag"></ion-icon>
                    <span>الرسوم</span>
                </a>
            </div>
        </nav>

        <div class="sidebar-footer">
            <div class="sidebar-user">
                <div class="sidebar-user-avatar">
                    <ion-icon name="person"></ion-icon>
                </div>
                <div class="sidebar-user-info">
                    <div class="sidebar-user-name"><%= typeof user !== 'undefined' && user ? user.name : 'مستخدم' %></div>
                    <div class="sidebar-user-role">مدير النظام</div>
                </div>
            </div>
            <a href="/logout" class="logout-btn">
                <ion-icon name="log-out"></ion-icon>
                <span>تسجيل الخروج</span>
            </a>
        </div>
    </aside>

    <!-- ========== TOPBAR ========== -->
    <header class="topbar">
        <div class="topbar-right">
            <button class="sidebar-toggle" onclick="toggleSidebar()">
                <ion-icon name="menu"></ion-icon>
            </button>
        </div>

        <div class="topbar-left">
            <div class="topbar-search" onclick="openSearch()">
                <ion-icon name="search"></ion-icon>
                <span>البحث عن مريض...</span>
                <kbd>⌘K</kbd>
            </div>
            <a href="/patient/add" class="add-patient-btn">
                <ion-icon name="person-add"></ion-icon>
                <span>مريض جديد</span>
            </a>
        </div>
    </header>

    <!-- ========== SEARCH MODAL ========== -->
    <div class="search-modal" id="searchModal" onclick="if(event.target === this) closeSearch()">
        <div class="search-container">
            <div class="search-input-wrapper">
                <ion-icon class="search-input-icon" name="search"></ion-icon>
                <input type="text" class="search-input" placeholder="البحث عن مريض بالاسم أو رقم الهاتف..." id="searchInput">
            </div>
            <div class="search-results" id="searchResults"></div>
        </div>
    </div>

    <!-- ========== MAIN CONTENT ========== -->
    <main class="main-content">
