<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-4Q6Gf2aSP4eDXB8Miphtr37CMZZQ5oXLH2yaXMJ2w8e2ZtHTl7GptT4jmndRuHDT" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-j1CDi7MgGQ12Z7Qab0qlWQ/Qqz24Gc6BM0thvEMVjHnfYGF0rmFCozFSxQBxwHKO"
        crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- Ionicons from jsDelivr - More reliable CDN -->
    <script type="module" src="https://cdn.jsdelivr.net/npm/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://cdn.jsdelivr.net/npm/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
    <title>عيادة مصطفى نبيل</title>

    <style>
        :root {
            --primary: #22C55E;
            --primary-dark: #16A34A;
            --success: #22C55E;
            --warning: #FF9500;
            --danger: #FF3B30;
            --purple: #AF52DE;
            --gray-25: #FCFCFD;
            --gray-50: #F9FAFB;
            --gray-100: #F3F4F6;
            --gray-200: #E5E7EB;
            --gray-300: #D1D5DB;
            --gray-400: #9CA3AF;
            --gray-500: #6B7280;
            --gray-600: #4B5563;
            --gray-700: #374151;
            --gray-800: #1F2937;
            --gray-900: #111827;
            --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.04);
            --shadow-md: 0 4px 12px 0 rgb(0 0 0 / 0.08);
            --shadow-lg: 0 12px 24px 0 rgb(0 0 0 / 0.12);
            --shadow-xl: 0 20px 40px 0 rgb(0 0 0 / 0.15);
            --radius-sm: 8px;
            --radius-md: 12px;
            --radius-lg: 16px;
            --radius-xl: 20px;
            --radius-full: 9999px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI", "Tajawal", sans-serif;
            background: linear-gradient(135deg, var(--gray-50) 0%, var(--gray-100) 100%);
            min-height: 100vh;
            direction: rtl;
            color: var(--gray-800);
            padding-top: 72px;
        }

        /* ========== NAVBAR ========== */
        .modern-navbar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: 72px;
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: saturate(180%) blur(20px);
            -webkit-backdrop-filter: saturate(180%) blur(20px);
            border-bottom: 1px solid rgba(0, 0, 0, 0.06);
            z-index: 1000;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .modern-navbar.scrolled {
            height: 64px;
            background: rgba(255, 255, 255, 0.95);
            box-shadow: var(--shadow-md);
        }

        .navbar-container {
            max-width: 100%;
            margin: 0 auto;
            padding: 0 20px;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            overflow-x: auto;
        }

        /* ========== BRAND ========== */
        .navbar-brand {
            display: flex;
            align-items: center;
            gap: 14px;
            text-decoration: none;
            transition: transform 0.2s ease;
        }

        .navbar-brand:hover {
            transform: scale(1.02);
        }

        .brand-logo {
            width: 44px;
            height: 44px;
            border-radius: var(--radius-md);
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 12px rgba(34, 197, 94, 0.25);
        }

        .brand-logo ion-icon {
            font-size: 26px;
            color: white;
        }

        .brand-text {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .brand-name {
            font-size: 17px;
            font-weight: 700;
            letter-spacing: -0.3px;
            color: var(--gray-900);
            line-height: 1.2;
        }

        .brand-subtitle {
            font-size: 12px;
            font-weight: 500;
            color: var(--gray-500);
            letter-spacing: 0.2px;
        }

        /* ========== NAVIGATION ========== */
        .navbar-nav {
            display: flex !important;
            flex-direction: row !important;
            align-items: center;
            gap: 4px;
            flex-wrap: nowrap;
            overflow-x: auto;
            overflow-y: hidden;
            -webkit-overflow-scrolling: touch;
        }

        .navbar-nav::-webkit-scrollbar {
            display: none;
        }

        .navbar-nav {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        .nav-item {
            position: relative;
            flex-shrink: 0;
        }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 8px 12px;
            border-radius: var(--radius-md);
            color: #22C55E !important;
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            white-space: nowrap;
        }

        .nav-link ion-icon {
            font-size: 18px;
            color: #22C55E !important;
        }

        .nav-link:hover {
            background: rgba(34, 197, 94, 0.15);
            transform: translateY(-1px);
            color: #16A34A !important;
        }

        .nav-link:hover ion-icon {
            color: #16A34A !important;
        }

        .nav-link.active {
            background: rgba(34, 197, 94, 0.2);
            box-shadow: 0 2px 8px rgba(34, 197, 94, 0.2);
            color: #16A34A !important;
        }

        .nav-link.active ion-icon {
            color: #16A34A !important;
        }

        .nav-link.active::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 50%;
            transform: translateX(-50%);
            width: 20px;
            height: 3px;
            background: var(--primary);
            border-radius: 2px;
        }

        /* ========== ACTIONS ========== */
        .navbar-actions {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .nav-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 10px 20px;
            border-radius: var(--radius-md);
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            text-decoration: none;
            border: none;
        }

        .nav-btn-primary {
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            color: white;
            box-shadow: 0 2px 8px rgba(34, 197, 94, 0.25);
        }

        .nav-btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(34, 197, 94, 0.35);
        }

        .nav-btn-secondary {
            background: var(--gray-100);
            color: var(--gray-700);
        }

        .nav-btn-secondary:hover {
            background: var(--gray-200);
        }

        .nav-icon-btn {
            width: 44px;
            height: 44px;
            border-radius: var(--radius-md);
            background: transparent;
            border: none;
            color: var(--gray-600);
            font-size: 22px;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .nav-icon-btn:hover {
            background: var(--gray-100);
            color: var(--gray-900);
        }

        .user-dropdown {
            position: relative;
        }

        .user-avatar-btn {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 6px 12px 6px 6px;
            border-radius: var(--radius-full);
            background: var(--gray-100);
            border: 2px solid transparent;
            cursor: pointer;
            transition: all 0.2s;
        }

        .user-avatar-btn:hover {
            background: var(--gray-200);
            border-color: var(--gray-300);
        }

        .user-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 18px;
            font-weight: 600;
        }

        .user-info {
            text-align: right;
        }

        .user-name {
            font-size: 14px;
            font-weight: 600;
            color: var(--gray-900);
            line-height: 1.2;
        }

        .user-role {
            font-size: 12px;
            color: var(--gray-500);
        }

        .dropdown-menu {
            position: absolute;
            top: calc(100% + 8px);
            left: 0;
            min-width: 200px;
            background: white;
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-xl);
            border: 1px solid var(--gray-200);
            opacity: 0;
            visibility: hidden;
            transform: translateY(-10px);
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            z-index: 1001;
            overflow: hidden;
        }

        .dropdown-menu.show {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .dropdown-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            color: var(--gray-700);
            text-decoration: none;
            font-size: 15px;
            transition: all 0.15s;
        }

        .dropdown-item:hover {
            background: var(--gray-50);
            color: var(--gray-900);
        }

        .dropdown-item ion-icon {
            font-size: 20px;
            color: var(--gray-400);
        }

        .dropdown-item.danger {
            color: var(--danger);
        }

        .dropdown-item.danger ion-icon {
            color: var(--danger);
        }

        .dropdown-item.danger:hover {
            background: rgba(255, 59, 48, 0.1);
        }

        .dropdown-divider {
            height: 1px;
            background: var(--gray-200);
            margin: 8px 0;
        }

        /* ========== MOBILE MENU ========== */
        .mobile-menu-btn {
            display: none;
            width: 44px;
            height: 44px;
            border-radius: var(--radius-md);
            background: transparent;
            border: none;
            color: var(--gray-700);
            font-size: 26px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .mobile-menu-btn:hover {
            background: var(--gray-100);
        }

        .mobile-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            z-index: 999;
            opacity: 0;
            transition: opacity 0.3s;
        }

        .mobile-overlay.show {
            display: block;
            opacity: 1;
        }

        .mobile-menu {
            position: fixed;
            top: 0;
            right: -100%;
            width: 320px;
            max-width: 90vw;
            height: 100vh;
            background: white;
            box-shadow: var(--shadow-xl);
            z-index: 1000;
            transition: right 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .mobile-menu.show {
            right: 0;
        }

        .mobile-menu-header {
            padding: 24px;
            background: linear-gradient(135deg, #22C55E 0%, #16A34A 100%);
            color: white;
        }

        .mobile-menu-user {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .mobile-menu-user .user-avatar {
            width: 56px;
            height: 56px;
            font-size: 24px;
            background: rgba(255, 255, 255, 0.25);
        }

        .mobile-menu-user .user-name {
            font-size: 18px;
            color: white;
        }

        .mobile-menu-user .user-role {
            font-size: 13px;
            color: rgba(255, 255, 255, 0.85);
        }

        .mobile-menu-nav {
            flex: 1;
            overflow-y: auto;
            padding: 16px;
        }

        .mobile-nav-item {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 16px;
            border-radius: var(--radius-md);
            color: var(--gray-700);
            text-decoration: none;
            font-size: 16px;
            font-weight: 500;
            transition: all 0.2s;
            margin-bottom: 4px;
        }

        .mobile-nav-item:hover {
            background: var(--gray-100);
            transform: translateX(-4px);
        }

        .mobile-nav-item ion-icon {
            font-size: 24px;
            color: var(--gray-400);
        }

        .mobile-nav-item.active {
            background: rgba(34, 197, 94, 0.1);
            color: var(--primary);
        }

        .mobile-nav-item.active ion-icon {
            color: var(--primary);
        }

        .mobile-menu-footer {
            padding: 16px;
            border-top: 1px solid var(--gray-200);
        }

        /* ========== RESPONSIVE ========== */
        @media (max-width: 1280px) {
            .navbar-nav {
                display: none !important;
            }

            .mobile-menu-btn {
                display: flex;
            }

            .navbar-actions .nav-btn span {
                display: none;
            }

            .navbar-actions .nav-btn {
                padding: 10px;
            }

            .navbar-container {
                padding: 0 16px;
            }
        }

        @media (max-width: 768px) {
            .brand-subtitle {
                display: none;
            }

            .user-info {
                display: none;
            }

            .user-avatar-btn {
                padding: 6px;
            }

            .nav-icon-btn {
                width: 40px;
                height: 40px;
            }
        }

        /* ========== SEARCH MODAL ========== */
        .search-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            z-index: 2000;
            align-items: flex-start;
            justify-content: center;
            padding-top: 120px;
            opacity: 0;
            transition: opacity 0.2s;
        }

        .search-modal.show {
            display: flex;
            opacity: 1;
        }

        .search-container {
            background: white;
            border-radius: var(--radius-xl);
            padding: 24px;
            width: 90%;
            max-width: 600px;
            box-shadow: var(--shadow-xl);
            transform: translateY(-20px);
            transition: transform 0.3s;
        }

        .search-modal.show .search-container {
            transform: translateY(0);
        }

        .search-input-wrapper {
            position: relative;
            margin-bottom: 16px;
        }

        .search-input {
            width: 100%;
            padding: 16px 56px;
            border: 2px solid var(--gray-200);
            border-radius: var(--radius-lg);
            font-size: 17px;
            font-family: inherit;
            background: var(--gray-50);
            transition: all 0.2s;
            direction: rtl;
        }

        .search-input:focus {
            outline: none;
            border-color: var(--primary);
            background: white;
            box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.1);
        }

        .search-icon {
            position: absolute;
            right: 16px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 22px;
            color: var(--gray-400);
        }

        .search-shortcut {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            padding: 4px 8px;
            background: var(--gray-200);
            border-radius: 6px;
            font-size: 12px;
            font-weight: 600;
            color: var(--gray-500);
        }

        .search-results {
            max-height: 400px;
            overflow-y: auto;
        }

        .search-result-item {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 14px;
            border-radius: var(--radius-md);
            cursor: pointer;
            transition: all 0.15s;
        }

        .search-result-item:hover {
            background: var(--gray-100);
        }

        .search-result-icon {
            width: 40px;
            height: 40px;
            border-radius: var(--radius-sm);
            background: var(--gray-100);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--gray-500);
        }

        .search-result-info h4 {
            font-size: 15px;
            font-weight: 600;
            color: var(--gray-900);
            margin-bottom: 2px;
        }

        .search-result-info p {
            font-size: 13px;
            color: var(--gray-500);
        }

        /* ========== ANIMATIONS ========== */
        @keyframes slideInRight {
            from {
                transform: translateX(100%);
                opacity: 0;
            }
            to {
                transform: translateX(0);
                opacity: 1;
            }
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
            }
            to {
                opacity: 1;
            }
        }

        /* Page Content */
        .main-content {
            min-height: calc(100vh - 72px);
        }
    </style>
</head>

<body>

    <!-- ========== NAVBAR ========== -->
    <nav class="modern-navbar" id="navbar">
        <div class="navbar-container">
            <!-- Brand -->
            <a href="/dashboard" class="navbar-brand">
                <div class="brand-logo">
                    <ion-icon name="medkit"></ion-icon>
                </div>
                <div class="brand-text">
                    <span class="brand-name">عيادة مصطفى نبيل</span>
                    <span class="brand-subtitle">الاخصائي النفسي</span>
                </div>
            </a>

            <!-- Navigation Links -->
            <% if (user) { %>
            <div class="navbar-nav">
                <a href="/dashboard" class="nav-link <%= typeof page !== 'undefined' && page === 'dashboard' ? 'active' : '' %>">
                    <ion-icon name="home"></ion-icon>
                    <span>الرئيسية</span>
                </a>
                <a href="/patient/history" class="nav-link <%= typeof page !== 'undefined' && page === 'patients' ? 'active' : '' %>">
                    <ion-icon name="people"></ion-icon>
                    <span>المرضى</span>
                </a>
                <a href="/bills" class="nav-link <%= typeof page !== 'undefined' && page === 'bills' ? 'active' : '' %>">
                    <ion-icon name="card"></ion-icon>
                    <span>الحسابات</span>
                </a>
                <a href="/course" class="nav-link <%= typeof page !== 'undefined' && page === 'courses' ? 'active' : '' %>">
                    <ion-icon name="layers"></ion-icon>
                    <span>الكورسات</span>
                </a>
                <a href="/tests" class="nav-link <%= typeof page !== 'undefined' && page === 'tests' ? 'active' : '' %>">
                    <ion-icon name="extension-puzzle"></ion-icon>
                    <span>الاختبارات</span>
                </a>
                <a href="/analysis" class="nav-link <%= typeof page !== 'undefined' && page === 'analysis' ? 'active' : '' %>">
                    <ion-icon name="analytics"></ion-icon>
                    <span>التقارير</span>
                </a>
                <a href="/expenses" class="nav-link <%= typeof page !== 'undefined' && page === 'expenses' ? 'active' : '' %>">
                    <ion-icon name="cash"></ion-icon>
                    <span>المصاريف</span>
                </a>
            </div>
            <% } %>

            <!-- Actions -->
            <div class="navbar-actions">
                <% if (user) { %>
                <!-- Search Button -->
                <button class="nav-icon-btn" onclick="openSearch()" title="البحث (⌘K)">
                    <ion-icon name="search"></ion-icon>
                </button>

                <!-- Add Patient Button -->
                <a href="/patient/add" class="nav-btn nav-btn-primary">
                    <ion-icon name="person-add"></ion-icon>
                </a>

                <!-- Mobile Menu Button -->
                <button class="mobile-menu-btn" onclick="toggleMobileMenu()">
                    <ion-icon name="menu"></ion-icon>
                </button>
                <% } %>
            </div>
        </div>
    </nav>

    <!-- ========== MOBILE MENU ========== -->
    <div class="mobile-overlay" id="mobileOverlay" onclick="closeMobileMenu()"></div>
    <div class="mobile-menu" id="mobileMenu">
        <div class="mobile-menu-header">
            <div class="mobile-menu-user">
                <div class="user-avatar">
                    <ion-icon name="person"></ion-icon>
                </div>
                <div>
                    <div class="user-name"><%= user ? user.name : 'زائر' %></div>
                    <div class="user-role"><%= user ? 'مدير النظام' : '' %></div>
                </div>
            </div>
        </div>

        <div class="mobile-menu-nav">
            <a href="/dashboard" class="mobile-nav-item" onclick="closeMobileMenu()">
                <ion-icon name="home"></ion-icon>
                <span>الرئيسية</span>
            </a>

            <a href="/patient/history" class="mobile-nav-item" onclick="closeMobileMenu()">
                <ion-icon name="people"></ion-icon>
                <span>سجل المرضى</span>
            </a>

            <a href="/patient/add" class="mobile-nav-item" onclick="closeMobileMenu()">
                <ion-icon name="person-add"></ion-icon>
                <span>مريض جديد</span>
            </a>

            <a href="/bills" class="mobile-nav-item" onclick="closeMobileMenu()">
                <ion-icon name="card"></ion-icon>
                <span>الحسابات</span>
            </a>

            <a href="/course" class="mobile-nav-item" onclick="closeMobileMenu()">
                <ion-icon name="layers"></ion-icon>
                <span>الكورسات</span>
            </a>

            <a href="/tests" class="mobile-nav-item" onclick="closeMobileMenu()">
                <ion-icon name="extension-puzzle"></ion-icon>
                <span>الاختبارات</span>
            </a>

            <a href="/exercise" class="mobile-nav-item" onclick="closeMobileMenu()">
                <ion-icon name="barbell"></ion-icon>
                <span>التمارين</span>
            </a>

            <a href="/analysis" class="mobile-nav-item" onclick="closeMobileMenu()">
                <ion-icon name="analytics"></ion-icon>
                <span>التقارير</span>
            </a>

            <a href="/expenses" class="mobile-nav-item" onclick="closeMobileMenu()">
                <ion-icon name="cash"></ion-icon>
                <span>المصاريف</span>
            </a>
        </div>

        <div class="mobile-menu-footer">
            <a href="/logout" class="mobile-nav-item danger" style="color: var(--danger);">
                <ion-icon name="log-out"></ion-icon>
                <span>تسجيل الخروج</span>
            </a>
        </div>
    </div>

    <!-- ========== SEARCH MODAL ========== -->
    <div class="search-modal" id="searchModal">
        <div class="search-container">
            <div class="search-input-wrapper">
                <ion-icon class="search-icon" name="search"></ion-icon>
                <input type="text" class="search-input" placeholder="البحث عن مريض..." id="searchInput" autofocus>
                <span class="search-shortcut">⌘K</span>
            </div>
            <div class="search-results" id="searchResults"></div>
        </div>
    </div>

    <script>
        // ========== SCROLL EFFECT ==========
        let lastScroll = 0;
        window.addEventListener('scroll', () => {
            const navbar = document.getElementById('navbar');
            const currentScroll = window.pageYOffset;

            if (currentScroll > 50) {
                navbar.classList.add('scrolled');
            } else {
                navbar.classList.remove('scrolled');
            }

            lastScroll = currentScroll;
        });

        // ========== USER DROPDOWN ==========
        function toggleUserDropdown() {
            const dropdown = document.getElementById('userDropdown');
            dropdown.classList.toggle('show');
        }

        // Close dropdown when clicking outside
        document.addEventListener('click', (e) => {
            const dropdown = document.getElementById('userDropdown');
            const userBtn = document.querySelector('.user-avatar-btn');

            if (!dropdown.contains(e.target) && !userBtn.contains(e.target)) {
                dropdown.classList.remove('show');
            }
        });

        // ========== MOBILE MENU ==========
        function toggleMobileMenu() {
            const menu = document.getElementById('mobileMenu');
            const overlay = document.getElementById('mobileOverlay');

            menu.classList.toggle('show');
            overlay.classList.toggle('show');
            document.body.style.overflow = menu.classList.contains('show') ? 'hidden' : '';
        }

        function closeMobileMenu() {
            const menu = document.getElementById('mobileMenu');
            const overlay = document.getElementById('mobileOverlay');

            menu.classList.remove('show');
            overlay.classList.remove('show');
            document.body.style.overflow = '';
        }

        // ========== SEARCH ==========
        function openSearch() {
            const modal = document.getElementById('searchModal');
            const input = document.getElementById('searchInput');

            modal.classList.add('show');
            input.value = '';
            input.focus();
        }

        function closeSearch() {
            const modal = document.getElementById('searchModal');
            modal.classList.remove('show');
        }

        // Search with debounce
        let searchTimeout;
        document.getElementById('searchInput')?.addEventListener('input', (e) => {
            clearTimeout(searchTimeout);
            const query = e.target.value.trim();

            if (query.length < 2) {
                document.getElementById('searchResults').innerHTML = '';
                return;
            }

            searchTimeout = setTimeout(() => {
                fetch(`/patient/api/patients?q=${encodeURIComponent(query)}`)
                    .then(res => res.json())
                    .then(data => {
                        const results = document.getElementById('searchResults');
                        if (data.patients && data.patients.length > 0) {
                            results.innerHTML = data.patients.map(p => `
                                <div class="search-result-item" onclick="window.location.href='/patient/get-by-id/${p._id}'">
                                    <div class="search-result-icon">
                                        <ion-icon name="person"></ion-icon>
                                    </div>
                                    <div class="search-result-info">
                                        <h4>${p.name}</h4>
                                        <p>${p.phone || 'لا يوجد هاتف'}</p>
                                    </div>
                                </div>
                            `).join('');
                        } else {
                            results.innerHTML = '<div style="text-align: center; padding: 40px; color: var(--gray-400);"><ion-icon name="search-outline" style="font-size: 48px; margin-bottom: 12px; display: block;"></ion-icon><p>لا توجد نتائج</p></div>';
                        }
                    })
                    .catch(err => {
                        console.error('Search error:', err);
                    });
            }, 300);
        });

        // ========== KEYBOARD SHORTCUTS ==========
        document.addEventListener('keydown', (e) => {
            // Cmd/Ctrl + K: Open search
            if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
                e.preventDefault();
                openSearch();
            }

            // Escape: Close modals
            if (e.key === 'Escape') {
                closeSearch();
                closeMobileMenu();
                document.getElementById('userDropdown')?.classList.remove('show');
            }
        });

        // ========== ACTIVE PAGE ==========
        function setActivePage() {
            const path = window.location.pathname;
            document.querySelectorAll('.nav-link, .mobile-nav-item').forEach(link => {
                link.classList.remove('active');
                const href = link.getAttribute('href');
                if (href && path.startsWith(href) && href !== '/') {
                    link.classList.add('active');
                }
            });
        }

        // ========== INIT ==========
        document.addEventListener('DOMContentLoaded', () => {
            setActivePage();
        });
    </script>
