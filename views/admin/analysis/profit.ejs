<%- include('../../layout/sidebar-start') -%>

<style>
    :root {
        --primary: #22C55E;
        --primary-dark: #16a34a;
        --danger: #ef4444;
        --warning: #f59e0b;
        --info: #3b82f6;
        --success: #10b981;
        --dark: #1f2937;
        --light: #f9fafb;
        --gray: #6b7280;
        --gray-light: #e5e7eb;
        --shadow: rgba(0, 0, 0, 0.1);
        --shadow-lg: rgba(0, 0, 0, 0.15);
    }

    .profit-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 30px 20px 100px 20px;
        direction: rtl;
    }

    /* Header */
    .profit-header {
        margin-bottom: 30px;
    }

    .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 20px;
        background: var(--gray-light);
        color: var(--dark);
        border-radius: 10px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        margin-bottom: 20px;
        transition: all 0.3s ease;
    }

    .back-btn:hover {
        background: #d1d5db;
        transform: translateX(4px);
    }

    .profit-header h1 {
        font-size: 24px;
        font-weight: 800;
        color: var(--dark);
        margin: 0 0 8px 0;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .profit-header h1 ion-icon {
        font-size: 28px;
        color: var(--success);
    }

    .date-range {
        font-size: 14px;
        color: var(--gray);
        display: flex;
        align-items: center;
        gap: 8px;
    }

    /* Stats Grid */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 20px var(--shadow);
        padding: 24px;
        border: 1px solid var(--gray-light);
        text-align: center;
        transition: all 0.3s ease;
    }

    .stat-card:hover {
        box-shadow: 0 8px 30px var(--shadow-lg);
        transform: translateY(-4px);
    }

    .stat-icon {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        margin: 0 auto 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
    }

    .stat-card.profit .stat-icon {
        background: linear-gradient(135deg, #dcfce7, #bbf7d0);
        color: #16a34a;
    }

    .stat-card.profit.negative .stat-icon {
        background: linear-gradient(135deg, #fee2e2, #fecaca);
        color: #dc2626;
    }

    .stat-card.paid .stat-icon {
        background: linear-gradient(135deg, #dbeafe, #bfdbfe);
        color: #1e40af;
    }

    .stat-card.fees .stat-icon {
        background: linear-gradient(135deg, #fee2e2, #fecaca);
        color: #dc2626;
    }

    .stat-card.unpaid .stat-icon {
        background: linear-gradient(135deg, #fef3c7, #fde68a);
        color: #d97706;
    }

    .stat-value {
        font-size: 28px;
        font-weight: 800;
        margin-bottom: 4px;
    }

    .stat-card.profit .stat-value {
        color: var(--success);
    }

    .stat-card.profit.negative .stat-value {
        color: var(--danger);
    }

    .stat-card.paid .stat-value {
        color: var(--info);
    }

    .stat-card.fees .stat-value {
        color: var(--danger);
    }

    .stat-card.unpaid .stat-value {
        color: var(--warning);
    }

    .stat-label {
        font-size: 14px;
        color: var(--gray);
        margin: 0;
    }

    /* Tables Section */
    .tables-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
        gap: 24px;
    }

    .table-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 20px var(--shadow);
        overflow: hidden;
        border: 1px solid var(--gray-light);
    }

    .table-card-header {
        padding: 20px 24px;
        background: linear-gradient(135deg, #f8fafc, #f1f5f9);
        border-bottom: 1px solid var(--gray-light);
    }

    .table-card-header h3 {
        font-size: 16px;
        font-weight: 700;
        color: var(--dark);
        margin: 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .table-card.paid .table-card-header ion-icon {
        font-size: 20px;
        color: var(--info);
    }

    .table-card.unpaid .table-card-header ion-icon {
        font-size: 20px;
        color: var(--warning);
    }

    .table-card.fees .table-card-header ion-icon {
        font-size: 20px;
        color: var(--danger);
    }

    .table-responsive {
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    thead {
        background: var(--light);
    }

    th {
        padding: 14px 16px;
        text-align: right;
        font-size: 13px;
        font-weight: 600;
        color: var(--gray);
        border-bottom: 2px solid var(--gray-light);
    }

    td {
        padding: 14px 16px;
        border-bottom: 1px solid var(--gray-light);
        font-size: 14px;
        color: var(--dark);
    }

    tbody tr {
        transition: all 0.3s ease;
    }

    tbody tr:hover {
        background: var(--light);
    }

    tbody tr:last-child td {
        border-bottom: none;
    }

    .total-row {
        background: var(--light) !important;
        font-weight: 700;
    }

    /* Empty State */
    .empty-state {
        text-align: center;
        padding: 40px 20px;
    }

    .empty-state p {
        font-size: 14px;
        color: var(--gray);
        margin: 0;
    }

    /* Responsive */
    @media (max-width: 768px) {
        .profit-container {
            padding: 20px 16px 80px 16px;
        }

        .profit-header h1 {
            font-size: 20px;
        }

        .stats-grid {
            grid-template-columns: 1fr 1fr;
        }

        .tables-grid {
            grid-template-columns: 1fr;
        }

        .stat-card {
            padding: 20px;
        }

        .stat-icon {
            width: 50px;
            height: 50px;
            font-size: 24px;
        }

        .stat-value {
            font-size: 24px;
        }

        .table-card-header {
            padding: 16px 20px;
        }

        th, td {
            padding: 12px 14px;
            font-size: 13px;
        }
    }
</style>

<div class="profit-container">
    <!-- Back Button -->
    <a href="/analysis" class="back-btn">
        <ion-icon name="arrow-forward"></ion-icon>
        العودة للتحليلات
    </a>

    <!-- Header -->
    <div class="profit-header">
        <h1>
            <ion-icon name="cash"></ion-icon>
            تحليل الأرباح العامة
        </h1>
        <div class="date-range">
            <ion-icon name="calendar-outline"></ion-icon>
            <%= startDate %> - <%= endDate %>
        </div>
    </div>

    <!-- Stats Grid -->
    <div class="stats-grid">
        <!-- Profit Card -->
        <div class="stat-card <% if(totalProfit > 0) { %>profit<% } else { %>profit negative<% } %>">
            <div class="stat-icon">
                <ion-icon name="trending-up"></ion-icon>
            </div>
            <div class="stat-value"><%= totalProfit.toLocaleString() %></div>
            <div class="stat-label">مجموع الأرباح</div>
        </div>

        <!-- Paid Bills Card -->
        <div class="stat-card paid">
            <div class="stat-icon">
                <ion-icon name="wallet"></ion-icon>
            </div>
            <div class="stat-value"><%= totalPaid.toLocaleString() %></div>
            <div class="stat-label">مجموع المدفوعات</div>
        </div>

        <!-- Fees Card -->
        <div class="stat-card fees">
            <div class="stat-icon">
                <ion-icon name="card"></ion-icon>
            </div>
            <div class="stat-value"><%= totalFees.toLocaleString() %></div>
            <div class="stat-label">مجموع المصاريف</div>
        </div>

        <!-- Unpaid Bills Card -->
        <div class="stat-card unpaid">
            <div class="stat-icon">
                <ion-icon name="alert-circle"></ion-icon>
            </div>
            <div class="stat-value"><%= totalUnpaid.toLocaleString() %></div>
            <div class="stat-label">مجموع الديون</div>
        </div>
    </div>

    <!-- Tables Grid -->
    <div class="tables-grid">
        <!-- Paid Bills Table -->
        <div class="table-card paid">
            <div class="table-card-header">
                <h3>
                    <ion-icon name="checkmark-circle"></ion-icon>
                    المدفوعات
                </h3>
            </div>
            <% if(paidBills.length > 0) { %>
                <div class="table-responsive">
                    <table>
                        <thead>
                            <tr>
                                <th>الاسم</th>
                                <th>المبلغ</th>
                                <th>الكورس</th>
                                <th>التاريخ</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% paidBills.forEach(data=> {%>
                                <tr>
                                    <td><%= data.patientName %></td>
                                    <td><%= data.price.toLocaleString() %></td>
                                    <td><%= data.sessions %></td>
                                    <td><%= data.Date %></td>
                                </tr>
                            <%}) %>
                            <tr class="total-row">
                                <td colspan="4">المجموع: <%= totalPaid.toLocaleString() %> د.ع</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <p>لا توجد مدفوعات</p>
                </div>
            <% } %>
        </div>

        <!-- Unpaid Bills Table -->
        <div class="table-card unpaid">
            <div class="table-card-header">
                <h3>
                    <ion-icon name="time"></ion-icon>
                    الديون
                </h3>
            </div>
            <% if(unpaidBills.length > 0) { %>
                <div class="table-responsive">
                    <table>
                        <thead>
                            <tr>
                                <th>الاسم</th>
                                <th>المبلغ</th>
                                <th>الكورس</th>
                                <th>التاريخ</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% unpaidBills.forEach(data=> {%>
                                <tr>
                                    <td><%= data.patientName %></td>
                                    <td><%= data.left.toLocaleString() %></td>
                                    <td><%= data.sessions %></td>
                                    <td><%= data.Date %></td>
                                </tr>
                            <%}) %>
                            <tr class="total-row">
                                <td colspan="4">المجموع: <%= totalUnpaid.toLocaleString() %> د.ع</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <p>لا توجد ديون</p>
                </div>
            <% } %>
        </div>

        <!-- Fees Table -->
        <div class="table-card fees">
            <div class="table-card-header">
                <h3>
                    <ion-icon name="receipt"></ion-icon>
                    المصاريف
                </h3>
            </div>
            <% if(filteredFees.length > 0) { %>
                <div class="table-responsive">
                    <table>
                        <thead>
                            <tr>
                                <th>العنوان</th>
                                <th>المبلغ</th>
                                <th>التاريخ</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% filteredFees.forEach(data=> {%>
                                <tr>
                                    <td><%= data.name %></td>
                                    <td><%= data.price.toLocaleString() %></td>
                                    <td><%= data.Date %></td>
                                </tr>
                            <%}) %>
                            <tr class="total-row">
                                <td colspan="3">المجموع: <%= totalFees.toLocaleString() %> د.ع</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <p>لا توجد مصاريف</p>
                </div>
            <% } %>
        </div>
    </div>
</div>

<%- include('../../layout/sidebar-end') -%>
