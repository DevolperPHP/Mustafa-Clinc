<%- include('../../layout/navbar') -%>

<style>
    :root {
        --primary: #22C55E;
        --primary-dark: #16a34a;
        --danger: #ef4444;
        --warning: #f59e0b;
        --info: #3b82f6;
        --success: #10b981;
        --purple: #8b5cf6;
        --purple-dark: #7c3aed;
        --dark: #1f2937;
        --light: #f9fafb;
        --gray: #6b7280;
        --gray-light: #e5e7eb;
        --shadow: rgba(0, 0, 0, 0.1);
        --shadow-lg: rgba(0, 0, 0, 0.15);
    }

    .daily-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 30px 20px 100px 20px;
        direction: rtl;
    }

    /* Header */
    .daily-header {
        margin-bottom: 30px;
    }

    .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 20px;
        background: var(--gray-light);
        color: var(--dark);
        border-radius: 10px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        margin-bottom: 20px;
        transition: all 0.3s ease;
    }

    .back-btn:hover {
        background: #d1d5db;
        transform: translateX(4px);
    }

    .daily-header h1 {
        font-size: 24px;
        font-weight: 800;
        color: var(--dark);
        margin: 0 0 8px 0;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .daily-header h1 ion-icon {
        font-size: 28px;
        color: var(--purple);
    }

    /* Date Picker Card */
    .date-picker-card {
        background: linear-gradient(135deg, var(--purple), var(--purple-dark));
        border-radius: 16px;
        padding: 20px 24px;
        margin-bottom: 30px;
        box-shadow: 0 4px 20px var(--shadow-lg);
        display: flex;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
    }

    .date-picker-card ion-icon {
        font-size: 24px;
        color: white;
    }

    .date-picker-card label {
        color: rgba(255, 255, 255, 0.9);
        font-size: 15px;
        font-weight: 600;
    }

    .date-picker-card input {
        padding: 10px 16px;
        border: none;
        border-radius: 8px;
        font-size: 14px;
        font-family: 'Tajawal', sans-serif;
        min-width: 200px;
        background: white;
        cursor: pointer;
    }

    /* Stats Grid */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 20px var(--shadow);
        padding: 24px;
        border: 1px solid var(--gray-light);
        text-align: center;
        transition: all 0.3s ease;
    }

    .stat-card:hover {
        box-shadow: 0 8px 30px var(--shadow-lg);
        transform: translateY(-4px);
    }

    .stat-icon {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        margin: 0 auto 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
    }

    .stat-card.total .stat-icon {
        background: linear-gradient(135deg, #ddd6fe, #c4b5fd);
        color: #7c3aed;
    }

    .stat-card.male .stat-icon {
        background: linear-gradient(135deg, #dbeafe, #bfdbfe);
        color: #1e40af;
    }

    .stat-card.female .stat-icon {
        background: linear-gradient(135deg, #fce7f3, #fbcfe8);
        color: #be185d;
    }

    .stat-value {
        font-size: 32px;
        font-weight: 800;
        margin-bottom: 4px;
    }

    .stat-card.total .stat-value {
        color: var(--purple);
    }

    .stat-card.male .stat-value {
        color: var(--info);
    }

    .stat-card.female .stat-value {
        color: #be185d;
    }

    .stat-label {
        font-size: 14px;
        color: var(--gray);
        margin: 0;
    }

    /* Table Card */
    .table-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 20px var(--shadow);
        overflow: hidden;
        border: 1px solid var(--gray-light);
    }

    .table-card-header {
        padding: 20px 28px;
        background: linear-gradient(135deg, #f8fafc, #f1f5f9);
        border-bottom: 1px solid var(--gray-light);
    }

    .table-card-header h3 {
        font-size: 18px;
        font-weight: 700;
        color: var(--dark);
        margin: 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .table-card-header ion-icon {
        font-size: 24px;
        color: var(--purple);
    }

    .table-responsive {
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    thead {
        background: var(--light);
    }

    th {
        padding: 14px 16px;
        text-align: right;
        font-size: 13px;
        font-weight: 600;
        color: var(--gray);
        border-bottom: 2px solid var(--gray-light);
        white-space: nowrap;
    }

    td {
        padding: 14px 16px;
        border-bottom: 1px solid var(--gray-light);
        font-size: 14px;
        color: var(--dark);
    }

    tbody tr {
        transition: all 0.3s ease;
        cursor: pointer;
    }

    tbody tr:hover {
        background: var(--light);
        transform: scale(1.01);
    }

    tbody tr:last-child td {
        border-bottom: none;
    }

    /* Empty State */
    .empty-state {
        text-align: center;
        padding: 60px 20px;
    }

    .empty-state ion-icon {
        font-size: 64px;
        color: var(--gray-light);
        margin-bottom: 16px;
    }

    .empty-state h3 {
        font-size: 18px;
        font-weight: 700;
        color: var(--dark);
        margin: 0 0 8px 0;
    }

    .empty-state p {
        font-size: 14px;
        color: var(--gray);
        margin: 0;
    }

    /* Responsive */
    @media (max-width: 768px) {
        .daily-container {
            padding: 20px 16px 80px 16px;
        }

        .daily-header h1 {
            font-size: 20px;
        }

        .date-picker-card {
            flex-direction: column;
            align-items: flex-start;
        }

        .date-picker-card input {
            width: 100%;
        }

        .stats-grid {
            grid-template-columns: 1fr 1fr;
        }

        .stat-card {
            padding: 20px;
        }

        .stat-icon {
            width: 48px;
            height: 48px;
            font-size: 22px;
        }

        .stat-value {
            font-size: 24px;
        }

        .table-card-header {
            padding: 16px 20px;
        }

        th, td {
            padding: 12px 14px;
            font-size: 13px;
        }
    }
</style>

<div class="daily-container">
    <!-- Back Button -->
    <a href="/analysis" class="back-btn">
        <ion-icon name="arrow-forward"></ion-icon>
        العودة للتحليلات
    </a>

    <!-- Header -->
    <div class="daily-header">
        <h1>
            <ion-icon name="calendar"></ion-icon>
            الزيارات اليومية
        </h1>
    </div>

    <!-- Date Picker Card -->
    <div class="date-picker-card">
        <ion-icon name="calendar-clear"></ion-icon>
        <label for="dateInput">اختر التاريخ:</label>
        <input type="date" id="dateInput" value="<%= targetDate %>">
        <script>
            document.getElementById('dateInput').addEventListener('change', function () {
                if (this.value) {
                    window.location.href = '/analysis/daily/' + this.value;
                }
            });
        </script>
    </div>

    <!-- Stats Grid -->
    <%
        let totalVisits = visits.length;
        let maleCount = visits.filter(v => v.gender === 'ذكر').length;
        let femaleCount = visits.filter(v => v.gender === 'انثى').length;
    %>
    <div class="stats-grid">
        <!-- Total Visits Card -->
        <div class="stat-card total">
            <div class="stat-icon">
                <ion-icon name="people"></ion-icon>
            </div>
            <div class="stat-value"><%= totalVisits %></div>
            <div class="stat-label">إجمالي الزيارات</div>
        </div>

        <!-- Male Patients Card -->
        <div class="stat-card male">
            <div class="stat-icon">
                <ion-icon name="man"></ion-icon>
            </div>
            <div class="stat-value"><%= maleCount %></div>
            <div class="stat-label">مراجعين ذكور</div>
        </div>

        <!-- Female Patients Card -->
        <div class="stat-card female">
            <div class="stat-icon">
                <ion-icon name="woman"></ion-icon>
            </div>
            <div class="stat-value"><%= femaleCount %></div>
            <div class="stat-label">مراجعات إناث</div>
        </div>
    </div>

    <!-- Table Card -->
    <div class="table-card">
        <div class="table-card-header">
            <h3>
                <ion-icon name="list-outline"></ion-icon>
                تفاصيل الزيارات
            </h3>
        </div>
        <% if(visits.length > 0) { %>
            <div class="table-responsive">
                <table>
                    <thead>
                        <tr>
                            <th>الاسم</th>
                            <th>نوع الكورس</th>
                            <th>الجنس</th>
                            <th>رقم الهاتف</th>
                            <th>تشخيص المعالج</th>
                            <th>تشخيص الطبيب</th>
                            <th>تاريخ التسجيل</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% visits.forEach(data=> {%>
                            <tr onclick="window.location.href='/patient/get-by-id/<%= data.id%>'">
                                <td><%= data.patientName %></td>
                                <td><%= data.courseType %></td>
                                <td><%= data.gender %></td>
                                <td><%= data.phone %></td>
                                <td><%= data.therapist_diagnose %></td>
                                <td><%= data.doctor_diagnose %></td>
                                <td><%= data.dateAdded %></td>
                            </tr>
                        <%}) %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="empty-state">
                <ion-icon name="calendar-outline"></ion-icon>
                <h3>لا توجد زيارات</h3>
                <p>لم يتم تسجيل أي زيارات في هذا التاريخ</p>
            </div>
        <% } %>
    </div>
</div>

<%- include('../../layout/footer') -%>
