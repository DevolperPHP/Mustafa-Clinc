<%- include('../../layout/navbar') -%>

<style>
    :root {
        --primary: #22C55E;
        --primary-dark: #16a34a;
        --primary-light: #86efac;
        --danger: #ef4444;
        --warning: #f59e0b;
        --info: #3b82f6;
        --success: #10b981;
        --dark: #1f2937;
        --light: #f9fafb;
        --gray: #6b7280;
        --gray-light: #e5e7eb;
        --shadow: rgba(0, 0, 0, 0.1);
        --shadow-lg: rgba(0, 0, 0, 0.15);
    }

    .patients-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 30px 20px 100px 20px;
        direction: rtl;
    }

    /* Header */
    .patients-header {
        margin-bottom: 30px;
    }

    .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 20px;
        background: var(--gray-light);
        color: var(--dark);
        border-radius: 10px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        margin-bottom: 20px;
        transition: all 0.3s ease;
    }

    .back-btn:hover {
        background: #d1d5db;
        transform: translateX(4px);
    }

    .patients-header h1 {
        font-size: 28px;
        font-weight: 800;
        color: var(--dark);
        margin: 0 0 8px 0;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .patients-header h1 ion-icon {
        font-size: 32px;
        color: var(--primary);
    }

    .patients-header p {
        font-size: 15px;
        color: var(--gray);
        margin: 0;
    }

    /* Filter Card */
    .filter-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 4px 24px var(--shadow);
        overflow: hidden;
        border: 1px solid var(--gray-light);
    }

    .filter-card-header {
        background: linear-gradient(135deg, var(--primary), var(--primary-dark));
        color: white;
        padding: 24px 32px;
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .filter-card-header ion-icon {
        font-size: 32px;
    }

    .filter-card-header div h2 {
        font-size: 20px;
        font-weight: 700;
        margin: 0 0 4px 0;
    }

    .filter-card-header div p {
        font-size: 14px;
        opacity: 0.9;
        margin: 0;
    }

    /* Filter Groups */
    .filter-section {
        padding: 32px;
    }

    .filter-section-title {
        font-size: 16px;
        font-weight: 700;
        color: var(--dark);
        margin: 0 0 20px 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .filter-section-title ion-icon {
        color: var(--primary);
        font-size: 20px;
    }

    .filters-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 20px;
        margin-bottom: 24px;
    }

    .filter-group {
        display: flex;
        flex-direction: column;
    }

    .filter-group.full-width {
        grid-column: 1 / -1;
    }

    .filter-group label {
        font-weight: 600;
        margin-bottom: 8px;
        color: var(--dark);
        font-size: 14px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .filter-group label ion-icon {
        color: var(--primary);
        font-size: 16px;
    }

    .form-control {
        padding: 12px 16px;
        border: 2px solid var(--gray-light);
        border-radius: 10px;
        font-size: 14px;
        font-family: 'Tajawal', sans-serif;
        transition: all 0.3s;
        direction: rtl;
        text-align: right;
        background: white;
    }

    .form-control:hover {
        border-color: #d1d5db;
    }

    .form-control:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.1);
        outline: none;
    }

    .form-control::placeholder {
        color: var(--gray);
    }

    /* Autocomplete Styles */
    .autocomplete {
        position: relative;
    }

    .autocomplete-items {
        position: absolute;
        border: 2px solid var(--primary);
        border-top: none;
        z-index: 9999;
        top: 100%;
        left: 0;
        right: 0;
        max-height: 300px;
        overflow-y: auto;
        background: white;
        box-shadow: 0 8px 24px var(--shadow-lg);
        border-radius: 0 0 12px 12px;
        direction: rtl;
    }

    .autocomplete-items div {
        padding: 14px 20px;
        cursor: pointer;
        border-bottom: 1px solid var(--gray-light);
        direction: rtl;
        text-align: right;
        font-size: 14px;
        transition: all 0.2s ease;
    }

    .autocomplete-items div:last-child {
        border-bottom: none;
        border-radius: 0 0 10px 10px;
    }

    .autocomplete-items div:hover {
        background: linear-gradient(135deg, var(--primary), var(--primary-dark));
        color: white;
        padding-right: 28px;
    }

    .autocomplete-items .autocomplete-active {
        background: var(--primary-dark);
        color: white;
        padding-right: 28px;
        font-weight: 600;
    }

    .autocomplete-items div strong {
        font-weight: 700;
        color: var(--primary);
    }

    .autocomplete-items div:hover strong,
    .autocomplete-items .autocomplete-active strong {
        color: white;
        text-decoration: underline;
    }

    /* Scrollbar styling */
    .autocomplete-items::-webkit-scrollbar {
        width: 8px;
    }

    .autocomplete-items::-webkit-scrollbar-track {
        background: var(--gray-light);
        border-radius: 0 0 10px 0;
    }

    .autocomplete-items::-webkit-scrollbar-thumb {
        background: var(--primary);
        border-radius: 4px;
    }

    .autocomplete-items::-webkit-scrollbar-thumb:hover {
        background: var(--primary-dark);
    }

    /* Actions Row */
    .actions-row {
        padding: 24px 32px;
        background: linear-gradient(135deg, #f0fdf4, #dcfce7);
        border-top: 1px solid var(--gray-light);
        display: flex;
        gap: 16px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .btn {
        padding: 14px 40px;
        font-size: 15px;
        border-radius: 12px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 10px;
        border: none;
        cursor: pointer;
        transition: all 0.3s;
        direction: rtl;
        font-family: 'Tajawal', sans-serif;
    }

    .btn-success {
        background: linear-gradient(135deg, var(--primary), var(--primary-dark));
        color: white;
        box-shadow: 0 4px 14px rgba(34, 197, 94, 0.3);
    }

    .btn-success:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(34, 197, 94, 0.4);
    }

    .btn-secondary {
        background: white;
        color: var(--gray);
        border: 2px solid var(--gray-light);
    }

    .btn-secondary:hover {
        background: var(--gray-light);
        transform: translateY(-2px);
    }

    /* Responsive */
    @media (max-width: 768px) {
        .patients-container {
            padding: 20px 16px 80px 16px;
        }

        .patients-header h1 {
            font-size: 22px;
        }

        .patients-header h1 ion-icon {
            font-size: 26px;
        }

        .filter-card-header {
            padding: 20px;
        }

        .filter-card-header ion-icon {
            font-size: 26px;
        }

        .filter-section {
            padding: 24px 20px;
        }

        .filters-grid {
            grid-template-columns: 1fr;
            gap: 16px;
        }

        .actions-row {
            padding: 20px;
            flex-direction: column;
        }

        .btn {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="patients-container">
    <!-- Back Button -->
    <a href="/analysis" class="back-btn">
        <ion-icon name="arrow-forward"></ion-icon>
        العودة للتحليلات
    </a>

    <!-- Header -->
    <div class="patients-header">
        <h1>
            <ion-icon name="people"></ion-icon>
            تحليل المراجعين
        </h1>
        <p>استخدم الفلاتر أدناه للبحث والتصفية حسب معايير متعددة</p>
    </div>

    <!-- Filter Card -->
    <div class="filter-card">
        <!-- Filter Card Header -->
        <div class="filter-card-header">
            <ion-icon name="funnel"></ion-icon>
            <div>
                <h2>فلاتر البحث المتقدم</h2>
                <p>اختر المعايير المطلوبة للبحث والتصفية</p>
            </div>
        </div>

        <!-- Filter Form -->
        <form action="/analysis/patients/filter" method="POST" id="filterForm">
            <div class="filter-section">
                <!-- Personal Information Section -->
                <div class="filter-section-title">
                    <ion-icon name="person"></ion-icon>
                    المعلومات الشخصية
                </div>
                <div class="filters-grid">
                    <div class="filter-group">
                        <label>
                            <ion-icon name="male-female"></ion-icon>
                            الجنس
                        </label>
                        <select name="gender" class="form-control">
                            <option value="">الكل</option>
                            <option value="ذكر">ذكر</option>
                            <option value="انثى">انثى</option>
                        </select>
                    </div>

                    <div class="filter-group">
                        <label>
                            <ion-icon name="book"></ion-icon>
                            التحصيل الدراسي
                        </label>
                        <select name="study" class="form-control">
                            <option value="">الكل</option>
                            <option>يقرا و يكتب</option>
                            <option>ابتدائي</option>
                            <option>متوسط</option>
                            <option>ثانوي</option>
                            <option>دبلوم</option>
                            <option>بكلوريوس</option>
                            <option>ماجستير</option>
                            <option>دكتوراة</option>
                        </select>
                    </div>

                    <div class="filter-group">
                        <label>
                            <ion-icon name="home"></ion-icon>
                            العنوان
                        </label>
                        <input type="text" name="address" class="form-control" placeholder="أدخل العنوان">
                    </div>

                    <div class="filter-group">
                        <label>
                            <ion-icon name="heart"></ion-icon>
                            الحالة الاجتماعية
                        </label>
                        <select name="relationship" class="form-control">
                            <option value="">الكل</option>
                            <option>اعزب</option>
                            <option>متزوج</option>
                            <option>ارمل</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="filter-section">
                <!-- Family Information Section -->
                <div class="filter-section-title">
                    <ion-icon name="people-circle"></ion-icon>
                    معلومات العائلة
                </div>
                <div class="filters-grid">
                    <div class="filter-group">
                        <label>
                            <ion-icon name="child"></ion-icon>
                            عدد الأطفال (من)
                        </label>
                        <input type="number" name="childrenMin" class="form-control" placeholder="الحد الأدنى" min="0">
                    </div>

                    <div class="filter-group">
                        <label>
                            <ion-icon name="child"></ion-icon>
                            عدد الأطفال (إلى)
                        </label>
                        <input type="number" name="childrenMax" class="form-control" placeholder="الحد الأقصى" min="0">
                    </div>

                    <div class="filter-group">
                        <label>
                            <ion-icon name="list-number"></ion-icon>
                            التسلسل في العائلة (من)
                        </label>
                        <input type="number" name="familyRankMin" class="form-control" placeholder="الحد الأدنى" min="1">
                    </div>

                    <div class="filter-group">
                        <label>
                            <ion-icon name="list-number"></ion-icon>
                            التسلسل في العائلة (إلى)
                        </label>
                        <input type="number" name="familyRankMax" class="form-control" placeholder="الحد الأقصى" min="1">
                    </div>
                </div>
            </div>

            <div class="filter-section">
                <!-- Health & Social Section -->
                <div class="filter-section-title">
                    <ion-icon name="medical"></ion-icon>
                    الجوانب الصحية والاجتماعية
                </div>
                <div class="filters-grid">
                    <div class="filter-group">
                        <label>
                            <ion-icon name="pulse"></ion-icon>
                            الجانب الصحي
                        </label>
                        <select name="health" class="form-control">
                            <option value="">الكل</option>
                            <option>جيد</option>
                            <option>متوسط</option>
                            <option>ضعيف</option>
                        </select>
                    </div>

                    <div class="filter-group">
                        <label>
                            <ion-icon name="psychology"></ion-icon>
                            الجانب النفسي
                        </label>
                        <select name="psycho" class="form-control">
                            <option value="">الكل</option>
                            <option>جيد</option>
                            <option>متوسط</option>
                            <option>ضعيف</option>
                        </select>
                    </div>

                    <div class="filter-group">
                        <label>
                            <ion-icon name="people"></ion-icon>
                            الجانب الاجتماعي
                        </label>
                        <select name="familyStatus" class="form-control">
                            <option value="">الكل</option>
                            <option>جيد</option>
                            <option>متوسط</option>
                            <option>ضعيف</option>
                        </select>
                    </div>

                    <div class="filter-group">
                        <label>
                            <ion-icon name="briefcase"></ion-icon>
                            الوظيفة
                        </label>
                        <input type="text" name="job" class="form-control" placeholder="أدخل الوظيفة">
                    </div>
                </div>
            </div>

            <div class="filter-section">
                <!-- Diagnosis Section -->
                <div class="filter-section-title">
                    <ion-icon name="medkit"></ion-icon>
                    التشخيص الطبي
                </div>
                <div class="filters-grid">
                    <div class="filter-group full-width">
                        <label>
                            <ion-icon name="stethoscope"></ion-icon>
                            تشخيص الطبيب
                        </label>
                        <div class="autocomplete">
                            <input type="text" name="doctorDiagnose" id="doctorDiagnose" class="form-control" placeholder="ابحث أو اكتب تشخيص الطبيب" autocomplete="off">
                        </div>
                    </div>

                    <div class="filter-group full-width">
                        <label>
                            <ion-icon name="person-circle"></ion-icon>
                            تشخيص الأخصائي
                        </label>
                        <div class="autocomplete">
                            <input type="text" name="therapistDiagnose" id="therapistDiagnose" class="form-control" placeholder="ابحث أو اكتب تشخيص الأخصائي" autocomplete="off">
                        </div>
                    </div>
                </div>
            </div>

            <div class="filter-section">
                <!-- Sessions Section -->
                <div class="filter-section-title">
                    <ion-icon name="calendar"></ion-icon>
                    معلومات الجلسات
                </div>
                <div class="filters-grid">
                    <div class="filter-group">
                        <label>
                            <ion-icon name="remove"></ion-icon>
                            عدد الجلسات (من)
                        </label>
                        <input type="number" name="sessionsMin" class="form-control" placeholder="الحد الأدنى" min="1">
                    </div>

                    <div class="filter-group">
                        <label>
                            <ion-icon name="remove"></ion-icon>
                            عدد الجلسات (إلى)
                        </label>
                        <input type="number" name="sessionsMax" class="form-control" placeholder="الحد الأقصى" min="1">
                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div class="actions-row">
                <button type="submit" class="btn btn-success">
                    <ion-icon name="search"></ion-icon>
                    بحث وتصفية
                </button>
                <button type="reset" class="btn btn-secondary" onclick="resetForm()">
                    <ion-icon name="refresh"></ion-icon>
                    إعادة تعيين
                </button>
            </div>
        </form>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/fuse.js@6.6.2"></script>
<script>
function resetForm() {
    document.getElementById('filterForm').reset();
}

function autocomplete(inp, arr) {
    let currentFocus;
    const fuse = new Fuse(arr, {
        threshold: 0.4,
    });

    inp.addEventListener("input", function () {
        let a, b, val = this.value;
        closeAllLists();
        if (!val) return false;
        currentFocus = -1;

        a = document.createElement("DIV");
        a.setAttribute("id", this.id + "autocomplete-list");
        a.setAttribute("class", "autocomplete-items");
        this.parentNode.appendChild(a);

        const results = fuse.search(val);
        results.slice(0, 10).forEach(({ item }) => {
            b = document.createElement("DIV");
            const matchIndex = item.indexOf(val);
            if (matchIndex >= 0) {
                b.innerHTML = `${item.substring(0, matchIndex)}<strong>${item.substring(matchIndex, matchIndex + val.length)}</strong>${item.substring(matchIndex + val.length)}`;
            } else {
                b.innerHTML = item;
            }
            b.innerHTML += `<input type='hidden' value='${item}'>`;
            b.addEventListener("click", function () {
                inp.value = this.getElementsByTagName("input")[0].value;
                closeAllLists();
                inp.focus();
            });
            a.appendChild(b);
        });
    });

    inp.addEventListener("keydown", function (e) {
        let x = document.getElementById(this.id + "autocomplete-list");
        if (!x) return;
        x = x.getElementsByTagName("div");

        if (e.keyCode == 40) {
            e.preventDefault();
            if (currentFocus < x.length - 1) {
                currentFocus++;
                addActive(x);
            }
        } else if (e.keyCode == 38) {
            e.preventDefault();
            if (currentFocus > 0) {
                currentFocus--;
                addActive(x);
            }
        } else if (e.keyCode == 13) {
            e.preventDefault();
            if (currentFocus > -1 && x[currentFocus]) {
                x[currentFocus].click();
            }
        } else if (e.keyCode == 27) {
            closeAllLists();
        }
    });

    function addActive(x) {
        if (!x) return false;
        removeActive(x);
        if (currentFocus >= x.length) currentFocus = 0;
        if (currentFocus < 0) currentFocus = x.length - 1;
        x[currentFocus].classList.add("autocomplete-active");
    }

    function removeActive(x) {
        for (let i = 0; i < x.length; i++) {
            x[i].classList.remove("autocomplete-active");
        }
    }

    function closeAllLists(elmnt) {
        const x = document.getElementsByClassName("autocomplete-items");
        for (let i = 0; i < x.length; i++) {
            if (elmnt != x[i] && elmnt != inp) {
                x[i].parentNode.removeChild(x[i]);
            }
        }
    }

    document.addEventListener("click", function (e) {
        closeAllLists(e.target);
    });
}

// Initialize autocomplete with diagnosis data
const diagnosisData = <%- diagnosisData %>;
autocomplete(document.getElementById("doctorDiagnose"), diagnosisData);
autocomplete(document.getElementById("therapistDiagnose"), diagnosisData);
</script>

<%- include('../../layout/footer') -%>
