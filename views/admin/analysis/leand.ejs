<%- include('../../layout/sidebar-start') -%>

<style>
    :root {
        --primary: #22C55E;
        --primary-dark: #16a34a;
        --danger: #ef4444;
        --warning: #f59e0b;
        --info: #3b82f6;
        --success: #10b981;
        --dark: #1f2937;
        --light: #f9fafb;
        --gray: #6b7280;
        --gray-light: #e5e7eb;
        --shadow: rgba(0, 0, 0, 0.1);
        --shadow-lg: rgba(0, 0, 0, 0.15);
    }

    .debts-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 30px 20px 100px 20px;
        direction: rtl;
    }

    /* Header */
    .debts-header {
        margin-bottom: 30px;
    }

    .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 20px;
        background: var(--gray-light);
        color: var(--dark);
        border-radius: 10px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        margin-bottom: 20px;
        transition: all 0.3s ease;
    }

    .back-btn:hover {
        background: #d1d5db;
        transform: translateX(4px);
    }

    .debts-header h1 {
        font-size: 24px;
        font-weight: 800;
        color: var(--dark);
        margin: 0 0 8px 0;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .debts-header h1 ion-icon {
        font-size: 28px;
        color: var(--warning);
    }

    .date-range {
        font-size: 14px;
        color: var(--gray);
        display: flex;
        align-items: center;
        gap: 8px;
    }

    /* Summary Card */
    .summary-card {
        background: linear-gradient(135deg, var(--warning), #d97706);
        color: white;
        padding: 24px 32px;
        border-radius: 16px;
        margin-bottom: 30px;
        box-shadow: 0 10px 30px var(--shadow-lg);
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
    }

    .summary-info {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .summary-icon {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        flex-shrink: 0;
    }

    .summary-info h2 {
        font-size: 18px;
        font-weight: 600;
        margin: 0 0 6px 0;
        opacity: 0.9;
    }

    .summary-info p {
        font-size: 14px;
        opacity: 0.8;
        margin: 0;
    }

    .summary-amount {
        text-align: left;
    }

    .summary-amount .amount-value {
        font-size: 32px;
        font-weight: 800;
        display: block;
    }

    .summary-amount .amount-label {
        font-size: 13px;
        opacity: 0.8;
    }

    /* Table Card */
    .table-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 20px var(--shadow);
        overflow: hidden;
        border: 1px solid var(--gray-light);
    }

    .table-card-header {
        padding: 20px 28px;
        background: linear-gradient(135deg, #f8fafc, #f1f5f9);
        border-bottom: 1px solid var(--gray-light);
    }

    .table-card-header h3 {
        font-size: 18px;
        font-weight: 700;
        color: var(--dark);
        margin: 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .table-card-header ion-icon {
        font-size: 24px;
        color: var(--warning);
    }

    .table-responsive {
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    thead {
        background: var(--light);
    }

    th {
        padding: 16px 20px;
        text-align: right;
        font-size: 14px;
        font-weight: 600;
        color: var(--gray);
        border-bottom: 2px solid var(--gray-light);
    }

    td {
        padding: 16px 20px;
        border-bottom: 1px solid var(--gray-light);
        font-size: 15px;
        color: var(--dark);
    }

    tbody tr {
        transition: all 0.3s ease;
    }

    tbody tr:hover {
        background: var(--light);
    }

    tbody tr:last-child td {
        border-bottom: none;
    }

    .total-row {
        background: linear-gradient(135deg, #fef3c7, #fde68a) !important;
        font-weight: 700;
    }

    .total-row td {
        color: #d97706;
        font-size: 16px;
    }

    /* Empty State */
    .empty-state {
        text-align: center;
        padding: 60px 20px;
    }

    .empty-state ion-icon {
        font-size: 64px;
        color: var(--gray-light);
        margin-bottom: 16px;
    }

    .empty-state h3 {
        font-size: 18px;
        font-weight: 700;
        color: var(--dark);
        margin: 0 0 8px 0;
    }

    .empty-state p {
        font-size: 14px;
        color: var(--gray);
        margin: 0;
    }

    /* Responsive */
    @media (max-width: 768px) {
        .debts-container {
            padding: 20px 16px 80px 16px;
        }

        .debts-header h1 {
            font-size: 20px;
        }

        .summary-card {
            flex-direction: column;
            text-align: center;
            padding: 20px;
        }

        .summary-info {
            flex-direction: column;
        }

        .summary-amount {
            text-align: center;
        }

        .summary-amount .amount-value {
            font-size: 28px;
        }

        .table-card-header {
            padding: 16px 20px;
        }

        th, td {
            padding: 12px 16px;
            font-size: 14px;
        }
    }
</style>

<div class="debts-container">
    <!-- Back Button -->
    <a href="/analysis" class="back-btn">
        <ion-icon name="arrow-forward"></ion-icon>
        العودة للتحليلات
    </a>

    <!-- Header -->
    <div class="debts-header">
        <h1>
            <ion-icon name="trending-down"></ion-icon>
            تحليل الديون
        </h1>
        <div class="date-range">
            <ion-icon name="calendar-outline"></ion-icon>
            <%= startDate %> - <%= endDate %>
        </div>
    </div>

    <!-- Summary Card -->
    <div class="summary-card">
        <div class="summary-info">
            <div class="summary-icon">
                <ion-icon name="alert-circle"></ion-icon>
            </div>
            <div>
                <h2>إجمالي الديون</h2>
                <p>المجموع الكلي للديون المتبقية</p>
            </div>
        </div>
        <div class="summary-amount">
            <span class="amount-value"><%= total.toLocaleString() %></span>
            <span class="amount-label">دينار عراقي</span>
        </div>
    </div>

    <!-- Table Card -->
    <div class="table-card">
        <div class="table-card-header">
            <h3>
                <ion-icon name="list-outline"></ion-icon>
                تفاصيل الديون
            </h3>
        </div>
        <% if(bills.length > 0) { %>
            <div class="table-responsive">
                <table>
                    <thead>
                        <tr>
                            <th>الاسم</th>
                            <th>المبلغ</th>
                            <th>الكورس</th>
                            <th>التاريخ</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% bills.forEach(data=> {%>
                            <tr>
                                <td><%= data.patientName %></td>
                                <td><%= data.left.toLocaleString() %> د.ع</td>
                                <td><%= data.sessions %></td>
                                <td><%= data.Date %></td>
                            </tr>
                        <%}) %>
                        <tr class="total-row">
                            <td colspan="4">المجموع: <%= total.toLocaleString() %> دينار عراقي</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="empty-state">
                <ion-icon name="checkmark-circle-outline"></ion-icon>
                <h3>لا توجد ديون</h3>
                <p>لم يتم تسجيل أي ديون في هذه الفترة</p>
            </div>
        <% } %>
    </div>
</div>

<%- include('../../layout/sidebar-end') -%>
