<%- include('../../layout/navbar') -%>
<style>
    .expenses-container {
        padding: 20px;
        max-width: 1400px;
        margin: 0 auto;
    }

    .dashboard-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .card {
        background: linear-gradient(135deg, #a4c842 0%, #8bb338 100%);
        border-radius: 15px;
        padding: 25px;
        color: white;
        box-shadow: 0 10px 30px rgba(164, 200, 66, 0.3);
        transition: transform 0.3s ease;
        cursor: pointer;
    }

    .card:hover {
        transform: translateY(-5px);
    }

    .card.today {
        background: linear-gradient(135deg, #a4c842 0%, #7fa02e 100%);
    }

    .card.month {
        background: linear-gradient(135deg, #a4c842 0%, #8bb338 100%);
    }

    .card.total {
        background: linear-gradient(135deg, #a4c842 0%, #6e9428 100%);
    }

    .card-title {
        font-size: 16px;
        opacity: 0.9;
        margin-bottom: 10px;
        text-align: center;
    }

    .card-value {
        font-size: 32px;
        font-weight: bold;
        text-align: center;
        margin-bottom: 5px;
    }

    .card-label {
        font-size: 12px;
        opacity: 0.8;
        text-align: center;
    }

    .category-section {
        background: white;
        border-radius: 15px;
        padding: 25px;
        margin-bottom: 30px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.1);
    }

    .section-title {
        font-size: 20px;
        font-weight: bold;
        margin-bottom: 20px;
        color: #333;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .category-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 15px;
    }

    .category-card {
        background: #f8f9fa;
        border-radius: 10px;
        padding: 15px;
        border-left: 4px solid #a4c842;
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .category-card:hover {
        background: #e9ecef;
        transform: translateX(5px);
    }

    .category-name {
        font-size: 14px;
        color: #666;
        margin-bottom: 5px;
    }

    .category-amount {
        font-size: 20px;
        font-weight: bold;
        color: #333;
    }

    .controls {
        background: white;
        border-radius: 15px;
        padding: 30px;
        margin-bottom: 20px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.1);
        direction: rtl;
    }

    .controls-row {
        display: grid;
        grid-template-columns: 1fr;
        gap: 20px;
        margin-bottom: 20px;
    }

    .controls-row:last-child {
        margin-bottom: 0;
    }

    .control-section {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        align-items: center;
        justify-content: flex-start;
    }

    .section-label {
        font-size: 14px;
        font-weight: bold;
        color: #555;
        margin-right: 10px;
        min-width: 120px;
        text-align: right;
    }

    .btn-add {
        background: linear-gradient(135deg, #a4c842 0%, #8bb338 100%);
        color: white;
        border: none;
        padding: 15px 40px;
        border-radius: 30px;
        font-size: 16px;
        font-weight: bold;
        cursor: pointer;
        box-shadow: 0 5px 15px rgba(164, 200, 66, 0.4);
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }

    .btn-add:hover {
        transform: translateY(-2px);
        box-shadow: 0 7px 20px rgba(164, 200, 66, 0.6);
    }

    .filter-input {
        padding: 12px 20px;
        border: 2px solid #e0e0e0;
        border-radius: 8px;
        font-size: 14px;
        transition: border-color 0.3s ease;
        min-width: 250px;
        direction: rtl;
        text-align: right;
    }

    .filter-input:focus {
        outline: none;
        border-color: #a4c842;
    }

    .date-range-container {
        border: 2px solid #a4c842;
        border-radius: 10px;
        padding: 20px;
        background: #f9f9f9;
    }

    .date-range-title {
        font-size: 16px;
        font-weight: bold;
        color: #333;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        gap: 10px;
        justify-content: flex-start;
        direction: rtl;
    }

    .date-inputs {
        display: flex;
        gap: 15px;
        align-items: center;
        flex-wrap: wrap;
        justify-content: flex-start;
    }

    .date-input {
        padding: 12px 15px;
        border: 2px solid #e0e0e0;
        border-radius: 8px;
        font-size: 14px;
        transition: border-color 0.3s ease;
        direction: rtl;
    }

    .date-input:focus {
        outline: none;
        border-color: #a4c842;
    }

    .date-inputs label {
        direction: rtl;
    }

    .btn-search {
        background: linear-gradient(135deg, #a4c842 0%, #8bb338 100%);
        color: white;
        border: none;
        padding: 12px 30px;
        border-radius: 25px;
        font-size: 14px;
        font-weight: bold;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .btn-search:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(164, 200, 66, 0.4);
    }

    .btn-clear {
        background: #999;
        color: white;
        border: none;
        padding: 12px 30px;
        border-radius: 25px;
        font-size: 14px;
        font-weight: bold;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .btn-clear:hover {
        background: #777;
    }

    .expenses-table {
        background: white;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(0,0,0,0.1);
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    thead {
        background: linear-gradient(135deg, #a4c842 0%, #8bb338 100%);
        color: white;
    }

    th {
        padding: 15px;
        text-align: right;
        font-weight: bold;
        font-size: 14px;
    }

    tbody tr {
        border-bottom: 1px solid #f0f0f0;
        transition: background-color 0.3s ease;
    }

    tbody tr:hover {
        background-color: #f8f9fa;
    }

    td {
        padding: 15px;
        text-align: right;
        font-size: 14px;
    }

    .category-badge {
        display: inline-block;
        padding: 5px 12px;
        border-radius: 15px;
        font-size: 12px;
        font-weight: bold;
        background: linear-gradient(135deg, #a4c842 0%, #8bb338 100%);
        color: white;
    }

    .amount-cell {
        font-weight: bold;
        font-size: 16px;
        color: #f5576c;
    }

    .btn-delete {
        background: #f5576c;
        color: white;
        border: none;
        padding: 8px 20px;
        border-radius: 20px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .btn-delete:hover {
        background: #d63447;
        transform: scale(1.05);
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #999;
    }

    .empty-state-icon {
        font-size: 64px;
        margin-bottom: 20px;
        opacity: 0.3;
    }

    /* Modal Styles */
    .modal {
        display: none;
        position: fixed;
        z-index: 9999;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0,0,0,0.5);
        animation: fadeIn 0.3s ease;
    }

    .modal-content {
        background-color: white;
        margin: 5% auto;
        padding: 30px;
        border-radius: 20px;
        width: 90%;
        max-width: 600px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.3);
        animation: slideDown 0.3s ease;
    }

    @keyframes slideDown {
        from {
            transform: translateY(-50px);
            opacity: 0;
        }
        to {
            transform: translateY(0);
            opacity: 1;
        }
    }

    @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    .modal-header {
        font-size: 24px;
        font-weight: bold;
        margin-bottom: 25px;
        color: #333;
        text-align: center;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        font-weight: bold;
        color: #555;
    }

    .form-group input, .form-group select, .form-group textarea {
        width: 100%;
        padding: 12px 15px;
        border: 2px solid #e0e0e0;
        border-radius: 10px;
        font-size: 14px;
        transition: border-color 0.3s ease;
        direction: rtl;
    }

    .form-group input:focus, .form-group select:focus, .form-group textarea:focus {
        outline: none;
        border-color: #a4c842;
    }

    .form-actions {
        display: flex;
        gap: 15px;
        justify-content: center;
        margin-top: 30px;
    }

    .btn-submit {
        background: linear-gradient(135deg, #a4c842 0%, #8bb338 100%);
        color: white;
        border: none;
        padding: 12px 40px;
        border-radius: 25px;
        font-size: 16px;
        font-weight: bold;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .btn-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(164, 200, 66, 0.4);
    }

    .btn-cancel {
        background: #ccc;
        color: #333;
        border: none;
        padding: 12px 40px;
        border-radius: 25px;
        font-size: 16px;
        font-weight: bold;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .btn-cancel:hover {
        background: #999;
    }

    .success-message {
        background: linear-gradient(135deg, #a4c842 0%, #8bb338 100%);
        color: white;
        padding: 15px;
        border-radius: 10px;
        margin-bottom: 20px;
        text-align: center;
        font-weight: bold;
    }

    .error-message {
        background: linear-gradient(135deg, #f5576c 0%, #e63946 100%);
        color: white;
        padding: 15px;
        border-radius: 10px;
        margin-bottom: 20px;
        text-align: center;
        font-weight: bold;
    }
</style>

<div class="expenses-container">
    <!-- Success/Error Messages -->
    <% if(suc.length > 0) { %>
        <div class="success-message">
            <%= suc %>
        </div>
    <% } %>
    <% if(err.length > 0) { %>
        <div class="error-message">
            <%= err %>
        </div>
    <% } %>

    <!-- Dashboard Cards -->
    <div class="dashboard-cards">
        <div class="card today" onclick="filterByDate('<%= todayDateForFilter %>')">
            <div class="card-title">مصروفات اليوم</div>
            <div class="card-value"><%= todayTotal.toLocaleString() %></div>
            <div class="card-label">د.ع</div>
        </div>
        <div class="card month">
            <div class="card-title">مصروفات الشهر</div>
            <div class="card-value"><%= monthTotal.toLocaleString() %></div>
            <div class="card-label">د.ع</div>
        </div>
        <div class="card total">
            <div class="card-title">إجمالي المصروفات</div>
            <div class="card-value"><%= totalAllTime.toLocaleString() %></div>
            <div class="card-label">د.ع</div>
        </div>
    </div>

    <!-- Title Breakdown -->
    <div class="category-section">
        <div class="section-title">
            توزيع المصروفات حسب العنوان (الشهر الحالي)
        </div>
        <div class="category-grid">
            <% Object.keys(titleTotals).forEach(title => { %>
                <div class="category-card" onclick="filterByTitle('<%= title %>')">
                    <div class="category-name"><%= title %></div>
                    <div class="category-amount"><%= titleTotals[title].toLocaleString() %> د.ع</div>
                </div>
            <% }) %>
        </div>
    </div>

    <!-- Controls -->
    <div class="controls">
        <!-- Add New Expense Section -->
        <div class="controls-row">
            <div class="control-section">
                <div class="section-label">إضافة مصروف</div>
                <button class="btn-add" onclick="openModal()">
                    إضافة مصروف جديد
                </button>
            </div>
        </div>

        <!-- Quick Search Section -->
        <div class="controls-row">
            <div class="control-section">
                <div class="section-label">البحث السريع</div>
                <input type="text" id="titleFilter" class="filter-input" placeholder="ابحث في عناوين المصروفات..." onkeyup="filterByTitleValue()">
            </div>
        </div>

        <!-- Date Filter Section -->
        <div class="controls-row">
            <div class="control-section">
                <div class="section-label">تصفية بالتاريخ</div>
                <input type="date" id="dateFilter" class="date-input" onchange="filterByDateValue()">
            </div>
        </div>

        <!-- Date Range Section -->
        <div class="controls-row">
            <div class="date-range-container">
                <div class="date-range-title">
                    البحث بالفترة الزمنية
                </div>
                <div class="date-inputs">
                    <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap; direction: rtl;">
                        <label style="font-weight: 500;">من</label>
                        <input type="date" id="dateFrom" class="date-input">
                    </div>
                    <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap; direction: rtl;">
                        <label style="font-weight: 500;">إلى</label>
                        <input type="date" id="dateTo" class="date-input">
                    </div>
                    <button class="btn-search" onclick="filterByDateRange()">بحث</button>
                    <button class="btn-clear" onclick="clearDateFilter()">مسح</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Expenses Table -->
    <div class="expenses-table">
        <% if(expenses.length > 0) { %>
            <table>
                <thead>
                    <tr>
                        <th>عنوان المصروف</th>
                        <th>الوصف</th>
                        <th>المبلغ</th>
                        <th>التاريخ</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    <% expenses.forEach(expense => { %>
                        <tr>
                            <td>
                                <span class="category-badge"><%= expense.title %></span>
                            </td>
                            <td><%= expense.description || '-' %></td>
                            <td class="amount-cell"><%= expense.amount.toLocaleString() %> د.ع</td>
                            <td><%= expense.date %></td>
                            <td>
                                <form action="/expenses/delete/<%= expense._id %>?_method=DELETE" method="post" style="display: inline;" onsubmit="return confirm('هل أنت متأكد من حذف هذا المصروف؟')">
                                    <button type="submit" class="btn-delete">حذف</button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        <% } else { %>
            <div class="empty-state">
                <h3>لا توجد مصروفات</h3>
                <p>ابدأ بإضافة مصروف جديد</p>
            </div>
        <% } %>
    </div>
</div>

<!-- Add Expense Modal -->
<div id="expenseModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">إضافة مصروف جديد</div>
        <form action="/expenses/new" method="post" id="expenseForm">
            <div class="form-group">
                <label>عنوان المصروف *</label>
                <input type="text" name="title" required placeholder="أدخل عنوان المصروف">
            </div>

            <div class="form-group">
                <label>الوصف</label>
                <input type="text" name="description" placeholder="أدخل وصف المصروف (اختياري)">
            </div>

            <div class="form-group">
                <label>المبلغ (د.ع) *</label>
                <input type="number" name="amount" required step="0.001" min="0" placeholder="0.000">
            </div>

            <div class="form-group">
                <label>التاريخ</label>
                <input type="date" name="date" value="<%= new Date().toISOString().split('T')[0] %>">
            </div>

            <div class="form-group">
                <label>ملاحظات</label>
                <textarea name="notes" rows="3" placeholder="ملاحظات إضافية (اختياري)"></textarea>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-submit">حفظ</button>
                <button type="button" class="btn-cancel" onclick="closeModal()">إلغاء</button>
            </div>
        </form>
    </div>
</div>

<script>
function openModal() {
    document.getElementById('expenseModal').style.display = 'block';
}

function closeModal() {
    document.getElementById('expenseModal').style.display = 'none';
}

function filterByDate(date) {
    window.location.href = '/expenses/filter/date/' + date;
}

function filterByDateValue() {
    const date = document.getElementById('dateFilter').value;
    if (date) {
        window.location.href = '/expenses/filter/date/' + date;
    } else {
        window.location.href = '/expenses';
    }
}

function filterByDateRange() {
    const dateFrom = document.getElementById('dateFrom').value;
    const dateTo = document.getElementById('dateTo').value;

    if (!dateFrom || !dateTo) {
        alert('يرجى تحديد تاريخ البداية ونهاية البحث');
        return;
    }

    if (dateFrom > dateTo) {
        alert('تاريخ البداية يجب أن يكون قبل تاريخ النهاية');
        return;
    }

    window.location.href = '/expenses/filter/date-range/' + dateFrom + '/' + dateTo;
}

function clearDateFilter() {
    document.getElementById('dateFrom').value = '';
    document.getElementById('dateTo').value = '';
    window.location.href = '/expenses';
}

function filterByTitle(title) {
    window.location.href = '/expenses/filter/title/' + encodeURIComponent(title);
}

function filterByTitleValue() {
    const title = document.getElementById('titleFilter').value;
    if (title) {
        // Filter by title is done client-side for text input
        const rows = document.querySelectorAll('tbody tr');
        rows.forEach(row => {
            const titleCell = row.querySelector('td:first-child');
            if (titleCell && titleCell.textContent.includes(title)) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    } else {
        // Show all rows if no filter
        const rows = document.querySelectorAll('tbody tr');
        rows.forEach(row => {
            row.style.display = '';
        });
    }
}

// Close modal when clicking outside
window.onclick = function(event) {
    const modal = document.getElementById('expenseModal');
    if (event.target == modal) {
        closeModal();
    }
}

// Auto hide messages after 3 seconds
setTimeout(function() {
    const messages = document.querySelectorAll('.success-message, .error-message');
    messages.forEach(function(message) {
        message.style.opacity = '0';
        setTimeout(function() {
            message.style.display = 'none';
        }, 300);
    });
}, 3000);
</script>

<br><br><br>
<%- include('../../layout/footer') -%>
