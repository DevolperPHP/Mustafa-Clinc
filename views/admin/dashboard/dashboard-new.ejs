<%- include('../../layout/navbar') -%>

<style>
:root {
    --primary: #22C55E;
    --primary-dark: #16A34A;
    --success: #22C55E;
    --warning: #FF9500;
    --danger: #FF3B30;
    --purple: #AF52DE;
    --pink: #FF2D55;
    --teal: #5AC8FA;
    --gray-25: #FCFCFD;
    --gray-50: #F9FAFB;
    --gray-100: #F3F4F6;
    --gray-200: #E5E7EB;
    --gray-300: #D1D5DB;
    --gray-400: #9CA3AF;
    --gray-500: #6B7280;
    --gray-600: #4B5563;
    --gray-700: #374151;
    --gray-800: #1F2937;
    --gray-900: #111827;
    --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.04);
    --shadow-md: 0 4px 12px 0 rgb(0 0 0 / 0.08);
    --shadow-lg: 0 12px 24px 0 rgb(0 0 0 / 0.12);
    --radius-sm: 8px;
    --radius-md: 12px;
    --radius-lg: 16px;
    --radius-xl: 20px;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    background: linear-gradient(135deg, var(--gray-50) 0%, var(--gray-100) 100%);
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI", "Tajawal", sans-serif;
    direction: rtl;
    min-height: 100vh;
    color: var(--gray-800);
}

.container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 28px;
}

/* Header Section */
.page-header {
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-radius: var(--radius-xl);
    padding: 28px 32px;
    margin-bottom: 28px;
    box-shadow: var(--shadow-sm);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    border: 1px solid rgba(0, 0, 0, 0.04);
}

.header-content h1 {
    font-size: 32px;
    font-weight: 700;
    letter-spacing: -0.5px;
    color: var(--gray-900);
    margin-bottom: 6px;
}

.greeting {
    color: var(--gray-500);
    font-size: 15px;
    font-weight: 400;
}

.quick-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
}

.btn {
    padding: 13px 24px;
    border-radius: var(--radius-md);
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    border: none;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
}

.btn-primary {
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
    color: white;
}

.btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(34, 197, 94, 0.3);
}

.btn-success {
    background: linear-gradient(135deg, var(--success) 0%, #2DA54A 100%);
    color: white;
}

.btn-success:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(52, 199, 89, 0.3);
}

/* Stats Grid */
.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(276px, 1fr));
    gap: 20px;
    margin-bottom: 28px;
}

.stat-card {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-radius: var(--radius-lg);
    padding: 24px;
    box-shadow: var(--shadow-sm);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(0, 0, 0, 0.04);
}

.stat-card::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 4px;
    height: 100%;
    background: var(--primary);
    transition: width 0.3s ease;
}

.stat-card:hover::before {
    width: 100%;
    opacity: 0.03;
}

.stat-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
}

.stat-card.success::before { background: var(--success); }
.stat-card.warning::before { background: var(--warning); }
.stat-card.danger::before { background: var(--danger); }
.stat-card.purple::before { background: var(--purple); }

.stat-header {
    display: flex;
    justify-content: space-between;
    align-items: start;
    margin-bottom: 16px;
}

.stat-icon-wrapper {
    width: 52px;
    height: 52px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
}

.stat-card.success .stat-icon-wrapper {
    background: linear-gradient(135deg, rgba(52, 199, 89, 0.15) 0%, rgba(52, 199, 89, 0.08) 100%);
    color: var(--success);
}

.stat-card.warning .stat-icon-wrapper {
    background: linear-gradient(135deg, rgba(255, 149, 0, 0.15) 0%, rgba(255, 149, 0, 0.08) 100%);
    color: var(--warning);
}

.stat-card.danger .stat-icon-wrapper {
    background: linear-gradient(135deg, rgba(255, 59, 48, 0.15) 0%, rgba(255, 59, 48, 0.08) 100%);
    color: var(--danger);
}

.stat-card.purple .stat-icon-wrapper {
    background: linear-gradient(135deg, rgba(175, 82, 222, 0.15) 0%, rgba(175, 82, 222, 0.08) 100%);
    color: var(--purple);
}

.stat-card:not(.success):not(.warning):not(.danger):not(.purple) .stat-icon-wrapper {
    background: linear-gradient(135deg, rgba(34, 197, 94, 0.15) 0%, rgba(34, 197, 94, 0.08) 100%);
    color: var(--primary);
}

.stat-value {
    font-size: 40px;
    font-weight: 800;
    letter-spacing: -1.5px;
    color: var(--gray-900);
    margin: 12px 0;
    line-height: 1;
}

.stat-label {
    font-size: 14px;
    color: var(--gray-500);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.stat-trend {
    font-size: 13px;
    margin-top: 14px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    font-weight: 600;
}

.stat-trend.up {
    color: var(--success);
    background: rgba(52, 199, 89, 0.1);
}

.stat-trend.down {
    color: var(--danger);
    background: rgba(255, 59, 48, 0.1);
}

.stat-trend.neutral {
    color: var(--gray-500);
    background: rgba(107, 114, 128, 0.1);
}

/* Content Section */
.content-section {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 20px;
}

@media (max-width: 1024px) {
    .content-section {
        grid-template-columns: 1fr;
    }
}

.section-card {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-radius: var(--radius-lg);
    padding: 28px;
    box-shadow: var(--shadow-sm);
    border: 1px solid rgba(0, 0, 0, 0.04);
}

.section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
}

.section-title {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.3px;
    color: var(--gray-900);
}

.section-count {
    background: var(--gray-100);
    padding: 6px 14px;
    border-radius: var(--radius-sm);
    font-size: 14px;
    font-weight: 600;
    color: var(--gray-600);
}

/* Patients List */
.patients-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.patient-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 20px;
    background: var(--gray-50);
    border-radius: var(--radius-md);
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
    border: 1px solid transparent;
}

.patient-item:hover {
    background: white;
    transform: translateX(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--gray-200);
}

.patient-item.completed {
    opacity: 0.7;
}

.patient-item.completed .patient-status {
    background: var(--success);
    color: white;
}

.patient-info h4 {
    margin: 0 0 6px 0;
    font-size: 17px;
    font-weight: 700;
    color: var(--gray-900);
}

.patient-info p {
    margin: 0;
    font-size: 14px;
    color: var(--gray-500);
    display: flex;
    align-items: center;
    gap: 8px;
}

.patient-status {
    padding: 5px 12px;
    border-radius: var(--radius-sm);
    font-size: 12px;
    font-weight: 600;
    background: var(--gray-200);
    color: var(--gray-600);
}

/* Empty State */
.empty-state {
    text-align: center;
    padding: 60px 24px;
    color: var(--gray-400);
}

.empty-state-icon {
    font-size: 56px;
    margin-bottom: 16px;
    opacity: 0.4;
}

.empty-state p {
    font-size: 16px;
    font-weight: 500;
}

/* Quick Actions Grid */
.quick-actions-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
}

.action-card {
    background: var(--gray-50);
    border-radius: var(--radius-md);
    padding: 20px;
    text-align: center;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    border: 1px solid transparent;
}

.action-card:hover {
    background: white;
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--gray-200);
}

.action-card ion-icon {
    font-size: 28px;
    margin-bottom: 10px;
    display: block;
}

.action-card span {
    font-size: 14px;
    font-weight: 600;
    color: var(--gray-700);
}

/* Search Bar */
.search-section {
    margin-bottom: 28px;
}

.search-wrapper {
    position: relative;
}

.search-input {
    width: 100%;
    padding: 18px 56px;
    border: 2px solid var(--gray-200);
    border-radius: var(--radius-lg);
    font-size: 17px;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    direction: rtl;
    box-shadow: var(--shadow-sm);
}

.search-input:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.1), var(--shadow-md);
}

.search-icon {
    position: absolute;
    right: 20px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 22px;
    color: var(--gray-400);
    pointer-events: none;
}

.search-hint {
    font-size: 13px;
    color: var(--gray-400);
    margin-top: 10px;
    text-align: center;
    font-weight: 500;
}

/* Recent & Overdue Sections */
.info-sections {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.info-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.info-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 16px;
    background: var(--gray-50);
    border-radius: var(--radius-sm);
    font-size: 14px;
    transition: all 0.2s;
    cursor: pointer;
}

.info-item:hover {
    background: white;
    box-shadow: var(--shadow-sm);
}

.info-item-name {
    font-weight: 600;
    color: var(--gray-800);
}

.info-item-detail {
    color: var(--gray-500);
    font-size: 13px;
}

.info-item.overdue {
    border-right: 3px solid var(--danger);
}

.info-item.overdue .info-item-detail {
    color: var(--danger);
    font-weight: 600;
}

/* Modal */
.modal-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 1000;
    align-items: center;
    justify-content: center;
}

.modal-overlay.active {
    display: flex;
}

.modal-content {
    background: white;
    border-radius: var(--radius-xl);
    padding: 36px;
    max-width: 540px;
    width: 90%;
    box-shadow: var(--shadow-lg);
    animation: modalIn 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes modalIn {
    from {
        opacity: 0;
        transform: scale(0.95) translateY(20px);
    }
    to {
        opacity: 1;
        transform: scale(1) translateY(0);
    }
}

.modal-title {
    font-size: 24px;
    font-weight: 700;
    margin-bottom: 8px;
    color: var(--gray-900);
}

.modal-subtitle {
    font-size: 15px;
    color: var(--gray-500);
    margin-bottom: 24px;
}

/* Responsive */
@media (max-width: 768px) {
    .container {
        padding: 16px;
    }

    .page-header {
        flex-direction: column;
        align-items: flex-start;
        padding: 20px;
    }

    .header-content h1 {
        font-size: 26px;
    }

    .stats-grid {
        grid-template-columns: 1fr;
    }

    .quick-actions {
        width: 100%;
        flex-direction: column;
    }

    .btn {
        width: 100%;
        justify-content: center;
    }

    .content-section {
        grid-template-columns: 1fr;
    }

    .quick-actions-grid {
        grid-template-columns: 1fr;
    }
}
</style>

<div class="container">
    <!-- Header -->
    <div class="page-header">
        <div class="header-content">
            <h1>مرحباً بك في العيادة</h1>
            <p class="greeting"><%= date %></p>
        </div>
        <div class="quick-actions">
            <a class="btn btn-primary" href="/patient/add">
                <ion-icon name="person-add"></ion-icon>
                مريض جديد
            </a>
            <button class="btn btn-success" onclick="showQuickRecord()">
                <ion-icon name="flash"></ion-icon>
                تسجيل سريع
            </button>
        </div>
    </div>

    <!-- Search -->
    <div class="search-section">
        <div class="search-wrapper">
            <ion-icon class="search-icon" name="search"></ion-icon>
            <input type="text" class="search-input" placeholder="البحث السريع عن مريض..."
                   id="globalSearch" onkeyup="handleSearch(event)">
        </div>
        <p class="search-hint">💡 اضغط Enter للبحث • ⌘K للتركيز على البحث</p>
    </div>

    <!-- Stats Grid -->
    <div class="stats-grid">
        <div class="stat-card success" onclick="window.location.href='/patient/history'">
            <div class="stat-header">
                <div class="stat-icon-wrapper">
                    <ion-icon name="people"></ion-icon>
                </div>
            </div>
            <div class="stat-value"><%= stats.totalPatients %></div>
            <div class="stat-label">إجمالي المرضى</div>
            <% if (stats.newThisMonth > 0) { %>
            <div class="stat-trend up">
                <ion-icon name="trending-up"></ion-icon>
                <span>+<%= stats.newThisMonth %> هذا الشهر</span>
            </div>
            <% } else { %>
            <div class="stat-trend neutral">
                <span>لا يوجد جدد</span>
            </div>
            <% } %>
        </div>

        <div class="stat-card warning" onclick="window.location.href='/analysis/daily/<%= today %>'">
            <div class="stat-header">
                <div class="stat-icon-wrapper">
                    <ion-icon name="calendar"></ion-icon>
                </div>
            </div>
            <div class="stat-value"><%= stats.todaySessions %></div>
            <div class="stat-label">جلسات اليوم</div>
            <% if (stats.todaySessions > 0) { %>
            <div class="stat-trend neutral">
                <span><%= stats.completedSessions %> مكتملة</span>
            </div>
            <% } else { %>
            <div class="stat-trend neutral">
                <span>لا توجد جلسات</span>
            </div>
            <% } %>
        </div>

        <div class="stat-card purple" onclick="window.location.href='/analysis/profit'">
            <div class="stat-header">
                <div class="stat-icon-wrapper">
                    <ion-icon name="wallet"></ion-icon>
                </div>
            </div>
            <div class="stat-value"><%= stats.todayRevenue.toLocaleString() %></div>
            <div class="stat-label">إيرادات اليوم (د.ع)</div>
            <% if (stats.revenueGrowth > 0) { %>
            <div class="stat-trend up">
                <ion-icon name="arrow-up"></ion-icon>
                <span>+<%= stats.revenueGrowth %>% عن أمس</span>
            </div>
            <% } else if (stats.revenueGrowth < 0) { %>
            <div class="stat-trend down">
                <ion-icon name="arrow-down"></ion-icon>
                <span><%= stats.revenueGrowth %>% عن أمس</span>
            </div>
            <% } else { %>
            <div class="stat-trend neutral">
                <span>مستقر</span>
            </div>
            <% } %>
        </div>

        <div class="stat-card danger" onclick="window.location.href='/bills'">
            <div class="stat-header">
                <div class="stat-icon-wrapper">
                    <ion-icon name="alert-circle"></ion-icon>
                </div>
            </div>
            <div class="stat-value"><%= stats.pendingPayments %></div>
            <div class="stat-label">دفعات معلقة</div>
            <% if (stats.overdueAmount > 0) { %>
            <div class="stat-trend down">
                <span><%= stats.overdueAmount.toLocaleString() %> د.ع مستحقة</span>
            </div>
            <% } else { %>
            <div class="stat-trend up">
                <span>الكل مسدد</span>
            </div>
            <% } %>
        </div>
    </div>

    <!-- Content Sections -->
    <div class="content-section">
        <!-- Today's Schedule -->
        <div class="section-card">
            <div class="section-header">
                <h2 class="section-title">مواعيد اليوم</h2>
                <span class="section-count"><%= todayPatients.length %></span>
            </div>

            <% if (todayPatients && todayPatients.length > 0) { %>
                <div class="patients-list">
                    <% todayPatients.forEach(patient => { %>
                        <div class="patient-item <%= patient.status === 'مكتمل' ? 'completed' : '' %>"
                             onclick="window.location.href='/patient/get-by-id/<%= patient._id %>'">
                            <div class="patient-info">
                                <h4><%= patient.name %></h4>
                                <p>
                                    <ion-icon name="swap-horizontal"></ion-icon>
                                    جلسة <%= patient.currentSession %>
                                    <% if (patient.status === 'مكتمل') { %>
                                        <span class="patient-status">مكتملة</span>
                                    <% } else { %>
                                        <span class="patient-status">قادمة</span>
                                    <% } %>
                                </p>
                            </div>
                            <div class="patient-actions">
                                <ion-icon name="chevron-back" style="color: var(--gray-400);"></ion-icon>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <ion-icon class="empty-state-icon" name="calendar-outline"></ion-icon>
                    <p>لا توجد مواعيد لليوم</p>
                </div>
            <% } %>
        </div>

        <!-- Quick Actions & Info -->
        <div class="info-sections">
            <!-- Quick Actions -->
            <div class="section-card">
                <h2 class="section-title" style="font-size: 17px; margin-bottom: 18px;">إجراءات سريعة</h2>
                <div class="quick-actions-grid">
                    <div class="action-card" onclick="window.location.href='/patient/history'">
                        <ion-icon name="folder" style="color: var(--primary);"></ion-icon>
                        <span>سجل المرضى</span>
                    </div>
                    <div class="action-card" onclick="window.location.href='/bills'">
                        <ion-icon name="card" style="color: var(--warning);"></ion-icon>
                        <span>الحسابات</span>
                    </div>
                    <div class="action-card" onclick="window.location.href='/analysis'">
                        <ion-icon name="analytics" style="color: var(--success);"></ion-icon>
                        <span>التقارير</span>
                    </div>
                    <div class="action-card" onclick="window.location.href='/course'">
                        <ion-icon name="layers" style="color: var(--purple);"></ion-icon>
                        <span>الكورسات</span>
                    </div>
                </div>
            </div>

            <!-- Overdue Payments -->
            <% if (overduePatients && overduePatients.length > 0) { %>
            <div class="section-card">
                <h2 class="section-title" style="font-size: 17px; margin-bottom: 18px;">مستحقات متأخرة</h2>
                <div class="info-list">
                    <% overduePatients.slice(0, 4).forEach(patient => { %>
                        <div class="info-item overdue" onclick="window.location.href='/patient/get-by-id/<%= patient._id %>'">
                            <span class="info-item-name"><%= patient.name %></span>
                            <span class="info-item-detail"><%= Math.abs(patient.balance) %> د.ك</span>
                        </div>
                    <% }) %>
                </div>
            </div>
            <% } %>

            <!-- Recent Patients -->
            <% if (recentPatients && recentPatients.length > 0) { %>
            <div class="section-card">
                <h2 class="section-title" style="font-size: 17px; margin-bottom: 18px;">أحدث المرضى</h2>
                <div class="info-list">
                    <% recentPatients.slice(0, 4).forEach(patient => { %>
                        <div class="info-item" onclick="window.location.href='/patient/get-by-id/<%= patient._id %>'">
                            <span class="info-item-name"><%= patient.name %></span>
                            <span class="info-item-detail"><%= patient.gender || '-' %></span>
                        </div>
                    <% }) %>
                </div>
            </div>
            <% } %>
        </div>
    </div>
</div>

<!-- Quick Record Modal -->
<div class="modal-overlay" id="quickRecordModal">
    <div class="modal-content">
        <h3 class="modal-title">تسجيل سريع</h3>
        <p class="modal-subtitle">ابحث عن المريض للتسجيل السريع</p>
        <div class="search-wrapper" style="margin-bottom: 20px;">
            <input type="text" class="search-input" placeholder="اكتب اسم المريض..."
                   id="quickSearch" onkeyup="quickSearch(event)">
        </div>
        <div id="quickResults" style="max-height: 320px; overflow-y: auto;"></div>
        <button class="btn" style="width: 100%; background: var(--gray-100); color: var(--gray-700); margin-top: 20px;"
                onclick="closeQuickRecord()">
            إلغاء
        </button>
    </div>
</div>

<script>
// Quick Record Modal
function showQuickRecord() {
    document.getElementById('quickRecordModal').classList.add('active');
    document.getElementById('quickSearch').focus();
}

function closeQuickRecord() {
    document.getElementById('quickRecordModal').classList.remove('active');
    document.getElementById('quickResults').innerHTML = '';
    document.getElementById('quickSearch').value = '';
}

// Global Search
function handleSearch(event) {
    if (event.key === 'Enter') {
        const query = event.target.value.trim();
        if (query) {
            window.location.href = `/patient/search/${encodeURIComponent(query)}`;
        }
    }
}

// Quick Search with debounce
let searchTimeout;
function quickSearch(event) {
    clearTimeout(searchTimeout);
    const query = event.target.value.trim();

    if (query.length < 2) {
        document.getElementById('quickResults').innerHTML = '';
        return;
    }

    searchTimeout = setTimeout(() => {
        fetch(`/patient/api/patients?q=${encodeURIComponent(query)}`)
            .then(res => res.json())
            .then(data => {
                const results = document.getElementById('quickResults');
                if (data.patients && data.patients.length > 0) {
                    results.innerHTML = data.patients.map(p => `
                        <div class="patient-item" onclick="window.location.href='/patient/get-by-id/${p._id}'; closeQuickRecord();">
                            <div class="patient-info">
                                <h4>${p.name}</h4>
                                <p>${p.phone || 'لا يوجد هاتف'}</p>
                            </div>
                        </div>
                    `).join('');
                } else {
                    results.innerHTML = '<div class="empty-state"><p>لا توجد نتائج</p></div>';
                }
            })
            .catch(err => {
                console.error('Search error:', err);
            });
    }, 300);
}

// Keyboard shortcuts
document.addEventListener('keydown', function(e) {
    // Cmd/Ctrl + K: Focus search
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        document.getElementById('globalSearch').focus();
    }

    // Cmd/Ctrl + N: New patient
    if ((e.metaKey || e.ctrlKey) && e.key === 'n') {
        e.preventDefault();
        window.location.href = '/patient/add';
    }

    // Cmd/Ctrl + R: Quick record (prevent refresh)
    if ((e.metaKey || e.ctrlKey) && e.key === 'r' && !e.shiftKey) {
        e.preventDefault();
        showQuickRecord();
    }

    // Escape: Close modal
    if (e.key === 'Escape') {
        closeQuickRecord();
    }
});

// Close modal on overlay click
document.getElementById('quickRecordModal').addEventListener('click', function(e) {
    if (e.target === this) {
        closeQuickRecord();
    }
});

// Auto-refresh dashboard stats every 30 seconds
setInterval(() => {
    fetch('/api/dashboard/stats')
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                console.log('Dashboard stats updated');
            }
        })
        .catch(err => console.error('Auto-refresh error:', err));
}, 30000);
</script>

