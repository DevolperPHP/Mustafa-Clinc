                        }
                    </script>
                                                                <script>
                                                function closeAcc() {
                                                    Swal.fire({
                                                        icon: 'warning',
                                                        showConfirmButton: false,
                                                        html: `
    <form action="/patient/close-acc/<%= data._id %>?_method=PUT" method="post" id="close-form">
        <label for="reason" style="font-weight: bold; display: block; margin-bottom: 5px;">سبب الإغلاق</label>
        <select name="reason" id="reason" style="width: 100%; padding: 8px; margin-bottom: 10px; border: 1px solid #ccc; border-radius: 4px;">
            <option value="تحقيق الاهداف العلاجية">تحقيبق الاهداف العلاجية</option>
            <option value="الانسحاب و عدم الالتزام بالجلسات">الانسحاب و عدم الالتزام بالجلسات</option>
            <option value="وفاة">وفاة</option>
            <option value="الانتقال الى مكان">الانتقال الى مكان</option>
            <option value="اخرى">أخرى</option>
        </select>

        <input type="text" name="customReason" id="customReason" placeholder="يرجى توضيح السبب"
            style="display: none; width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; margin-bottom: 10px;" />

        <div style="text-align: center;">
            <button type="submit" class="btn btn-danger">إغلاق الحساب</button>
            <button type="button" class="btn btn-secondary" onclick="Swal.close()">إلغاء</button>
        </div>
    </form>
    `,
                                                        didOpen: () => {
                                                            const reasonSelect = document.getElementById('reason');
                                                            const customInput = document.getElementById('customReason');

                                                            reasonSelect.addEventListener('change', () => {
                                                                if (reasonSelect.value === 'اخرى') {
                                                                    customInput.style.display = 'block';
                                                                    customInput.setAttribute('required', true);
                                                                } else {
                                                                    customInput.style.display = 'none';
                                                                    customInput.removeAttribute('required');
                                                                }
                                                            });
                                                        }
                                                    });

                                                }

                                                function openAcc() {
                                                    Swal.fire({
    icon: 'info',
    title: 'فتح الحساب',
    showConfirmButton: false,
    html: `
        <form action="/patient/open-acc/<%= data._id %>?_method=PUT" method="post" id="open-form">
            <label for="note" style="font-weight: bold; display: block; margin-bottom: 5px;">ملاحظة (اختياري)</label>
            <input type="text" name="note" id="note"
                placeholder="أدخل ملاحظة لفتح الحساب"
                style="width: 100%; padding: 8px; margin-bottom: 15px; border: 1px solid #ccc; border-radius: 4px;" />

            <div style="text-align: center;">
                <button type="submit" class="btn btn-success">فتح الحساب</button>
                <button type="button" class="btn btn-secondary" onclick="Swal.close()">إلغاء</button>
            </div>
        </form>
    `
});


                                                }

                                                // Course price data for profile page
                                                const coursePrices2 = {
                                                    <% courses.forEach((course, index) => { %>
                                                        "<%= course.sessions %>": <%= course.price %><%= index < courses.length - 1 ? ',' : '' %>
                                                    <% }) %>
                                                };

                                                // Show/hide discount section based on course selection
                                                document.getElementById('courseSelect2').addEventListener('change', function() {
                                                    const discountSection = document.getElementById('discountSection2');
                                                    if (this.value) {
                                                        discountSection.style.display = 'block';
                                                        updateDiscountPreview2();
                                                    } else {
                                                        discountSection.style.display = 'none';
                                                    }
                                                });

                                                // Update label and validation based on discount type
                                                document.querySelectorAll('input[name="discountType"]').forEach(radio => {
                                                    radio.addEventListener('change', function() {
                                                        const label = document.getElementById('discountValueLabel2');
                                                        const input = document.getElementById('discountValue2');
                                                        if (this.value === 'percentage') {
                                                            label.textContent = 'قيمة الخصم (%):';
                                                            input.max = '100';
                                                            input.placeholder = 'أدخل النسبة (1-100)';
                                                        } else {
                                                            label.textContent = 'قيمة الخصم (د.ك):';
                                                            input.max = '';
                                                            input.placeholder = 'أدخل المبلغ';
                                                        }
                                                        updateDiscountPreview2();
                                                    });
                                                });

                                                // Update discount preview on value change
                                                document.getElementById('discountValue2').addEventListener('input', function() {
                                                    updateDiscountPreview2();
                                                });

                                                function updateDiscountPreview2() {
                                                    const courseSelect = document.getElementById('courseSelect2');
                                                    const discountType = document.querySelector('input[name="discountType"]:checked');
                                                    const discountValue = document.getElementById('discountValue2').value;

                                                    if (courseSelect.value && discountType && discountValue) {
                                                        const originalPrice = coursePrices2[courseSelect.value] || 0;
                                                        const value = Number(discountValue);
                                                        let discountAmount = 0;

                                                        if (discountType.value === 'percentage') {
                                                            discountAmount = (originalPrice * value) / 100;
                                                        } else if (discountType.value === 'fixed') {
                                                            discountAmount = value;
                                                        }

                                                        const finalPrice = originalPrice - discountAmount;

                                                        document.getElementById('originalPrice2').textContent = originalPrice.toLocaleString();
                                                        document.getElementById('discountAmount2').textContent = discountAmount.toLocaleString();
                                                        document.getElementById('finalPrice2').textContent = finalPrice.toLocaleString();
                                                        document.getElementById('discountPreview2').style.display = 'block';
                                                    } else {
                                                        document.getElementById('discountPreview2').style.display = 'none';
                                                    }
                                                }
                                            </script>

                    <%- include('../../layout/footer') -%>