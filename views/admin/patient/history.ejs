<%- include('../../layout/sidebar-start') -%>

<!-- Fuse.js for fuzzy search - Load before main script -->
<script src="https://cdn.jsdelivr.net/npm/fuse.js@6.6.2?v=2"></script>

<style>
:root {
    --primary: #22C55E;
    --primary-dark: #16A34A;
    --primary-light: rgba(34, 197, 94, 0.1);
    --success: #22C55E;
    --warning: #FF9500;
    --danger: #FF3B30;
    --purple: #AF52DE;
    --gray-25: #FCFCFD;
    --gray-50: #F9FAFB;
    --gray-100: #F3F4F6;
    --gray-200: #E5E7EB;
    --gray-300: #D1D5DB;
    --gray-400: #9CA3AF;
    --gray-500: #6B7280;
    --gray-600: #4B5563;
    --gray-700: #374151;
    --gray-800: #1F2937;
    --gray-900: #111827;
    --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.04);
    --shadow-md: 0 4px 12px 0 rgb(0 0 0 / 0.08);
    --shadow-lg: 0 12px 24px 0 rgb(0 0 0 / 0.12);
    --shadow-xl: 0 20px 40px 0 rgb(0 0 0 / 0.15);
    --radius-sm: 8px;
    --radius-md: 12px;
    --radius-lg: 16px;
    --radius-xl: 20px;
    --radius-full: 9999px;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI", "Tajawal", sans-serif;
    background: linear-gradient(135deg, var(--gray-50) 0%, var(--gray-100) 100%);
    min-height: 100vh;
    direction: rtl;
    color: var(--gray-800);
    padding-top: 72px;
}

/* ========== MAIN CONTAINER ========== */
.main-content {
    max-width: 1400px;
    margin: 0 auto;
    padding: 28px;
}

/* ========== HEADER ========== */
.page-header {
    margin-bottom: 28px;
}

.page-title-section {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    flex-wrap: wrap;
    gap: 20px;
}

.page-title {
    font-size: 36px;
    font-weight: 800;
    letter-spacing: -1px;
    color: var(--gray-900);
    line-height: 1.2;
}

.page-subtitle {
    font-size: 15px;
    color: var(--gray-500);
    margin-top: 4px;
}

.page-actions {
    display: flex;
    gap: 12px;
}

/* ========== BUTTONS ========== */
.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 14px 24px;
    border-radius: var(--radius-md);
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    border: none;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    text-decoration: none;
    white-space: nowrap;
}

.btn-primary {
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
    color: white;
    box-shadow: 0 2px 8px rgba(34, 197, 94, 0.25);
}

.btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(34, 197, 94, 0.35);
}

/* ========== STATS BAR ========== */
.stats-bar {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    margin-bottom: 28px;
}

.stat-item {
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-radius: var(--radius-lg);
    padding: 20px;
    box-shadow: var(--shadow-sm);
    border: 1px solid rgba(0, 0, 0, 0.04);
    display: flex;
    align-items: center;
    gap: 16px;
    transition: all 0.2s;
}

.stat-item:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
}

.stat-icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    background: var(--primary-light);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    color: var(--primary);
}

.stat-content {
    flex: 1;
}

.stat-value {
    font-size: 24px;
    font-weight: 800;
    color: var(--gray-900);
    line-height: 1.2;
}

.stat-label {
    font-size: 13px;
    color: var(--gray-500);
    margin-top: 2px;
}

/* ========== PATIENTS SECTION ========== */
.patients-section {
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
    border: 1px solid rgba(0, 0, 0, 0.04);
    overflow: hidden;
}

.patients-header {
    padding: 32px;
    border-bottom: 1px solid var(--gray-200);
}

.patients-title-section {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    flex-wrap: wrap;
    gap: 16px;
}

.patients-header-title {
    font-size: 24px;
    font-weight: 800;
    color: var(--gray-900);
}

.patients-count {
    font-size: 14px;
    color: var(--gray-500);
    font-weight: 500;
}

/* ========== SEARCH BAR ========== */
.search-bar {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    align-items: center;
}

.search-input-wrapper {
    flex: 1;
    min-width: 280px;
    position: relative;
}

.search-input {
    width: 100%;
    padding: 14px 48px;
    border: 2px solid var(--gray-200);
    border-radius: var(--radius-lg);
    font-size: 15px;
    font-family: inherit;
    background: var(--gray-50);
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    direction: rtl;
}

.search-input:focus {
    outline: none;
    border-color: var(--primary);
    background: white;
    box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.1);
}

.search-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 20px;
    color: var(--gray-400);
    pointer-events: none;
    transition: color 0.2s;
}

.search-input:focus ~ .search-icon {
    color: var(--primary);
}

.clear-search {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    width: 28px;
    height: 28px;
    background: var(--gray-200);
    border: none;
    border-radius: var(--radius-full);
    color: var(--gray-500);
    cursor: pointer;
    display: none;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
    font-size: 12px;
}

.clear-search:hover {
    background: var(--gray-300);
    color: var(--gray-700);
}

.clear-search.visible {
    display: flex;
}

/* Search Filters */
.search-filters {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
}

.filter-chip {
    padding: 10px 18px;
    border-radius: var(--radius-full);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    border: 2px solid var(--gray-200);
    background: white;
    color: var(--gray-600);
    transition: all 0.2s;
    white-space: nowrap;
}

.filter-chip:hover {
    border-color: var(--gray-300);
    background: var(--gray-50);
}

.filter-chip.active {
    background: var(--primary);
    border-color: var(--primary);
    color: white;
}

.search-hint {
    font-size: 12px;
    color: var(--gray-400);
    margin-top: 12px;
    font-weight: 500;
}

.search-hint kbd {
    display: inline-block;
    padding: 3px 6px;
    background: var(--gray-100);
    border: 1px solid var(--gray-200);
    border-radius: 4px;
    font-family: inherit;
    font-size: 11px;
    margin: 0 3px;
    color: var(--gray-600);
}

/* ========== PATIENTS GRID ========== */
.patients-content {
    padding: 32px;
}

.patients-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 20px;
}

/* ========== PATIENT CARD ========== */
.patient-card {
    background: white;
    border: 1px solid var(--gray-200);
    border-radius: var(--radius-lg);
    padding: 20px;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
}

.patient-card::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 4px;
    height: 100%;
    background: linear-gradient(180deg, var(--primary) 0%, var(--primary-dark) 100%);
    opacity: 0;
    transition: opacity 0.3s;
}

.patient-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--primary);
}

.patient-card:hover::before {
    opacity: 1;
}

.patient-card-header {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 16px;
}

.patient-avatar {
    width: 52px;
    height: 52px;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 24px;
    font-weight: 700;
    flex-shrink: 0;
}

.patient-info {
    flex: 1;
    min-width: 0;
}

.patient-name {
    font-size: 17px;
    font-weight: 700;
    color: var(--gray-900);
    margin-bottom: 4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.patient-meta {
    font-size: 13px;
    color: var(--gray-500);
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
}

.patient-meta-item {
    display: flex;
    align-items: center;
    gap: 4px;
}

.patient-card-body {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
}

.patient-tag {
    padding: 6px 12px;
    border-radius: var(--radius-full);
    font-size: 12px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 6px;
}

.tag-code {
    background: var(--primary-light);
    color: var(--primary);
}

.tag-date {
    background: var(--gray-100);
    color: var(--gray-600);
}

.tag-active {
    background: rgba(34, 197, 94, 0.15);
    color: var(--primary);
}

.tag-inactive {
    background: var(--gray-100);
    color: var(--gray-500);
}

/* ========== EMPTY STATE ========== */
.empty-state {
    text-align: center;
    padding: 80px 32px;
}

.empty-state-icon {
    font-size: 64px;
    color: var(--gray-300);
    margin-bottom: 20px;
}

.empty-state-title {
    font-size: 20px;
    font-weight: 700;
    color: var(--gray-900);
    margin-bottom: 8px;
}

.empty-state-text {
    font-size: 15px;
    color: var(--gray-500);
}

/* ========== LOADING ========== */
.loading-state {
    text-align: center;
    padding: 60px 32px;
    display: none;
}

.loading-state.visible {
    display: block;
}

.spinner {
    width: 48px;
    height: 48px;
    border: 4px solid var(--gray-200);
    border-top-color: var(--primary);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin: 0 auto 16px;
}

@keyframes spin {
    to { transform: rotate(360deg); }
}

.loading-text {
    font-size: 15px;
    color: var(--gray-500);
}

/* ========== RESPONSIVE ========== */
@media (max-width: 768px) {
    .main-content {
        padding: 16px;
    }

    .page-title {
        font-size: 28px;
    }

    .page-title-section {
        flex-direction: column;
        align-items: flex-start;
    }

    .search-bar {
        flex-direction: column;
    }

    .search-input-wrapper {
        min-width: 100%;
    }

    .search-filters {
        width: 100%;
        justify-content: center;
    }

    .stats-bar {
        grid-template-columns: 1fr;
    }

    .patients-grid {
        grid-template-columns: 1fr;
    }

    .page-actions {
        width: 100%;
    }

    .btn {
        flex: 1;
    }

    .patients-header {
        padding: 20px;
    }

    .patients-content {
        padding: 20px;
    }
}

/* ========== SCROLLBAR ========== */
.patients-grid::-webkit-scrollbar {
    width: 8px;
}

.patients-grid::-webkit-scrollbar-track {
    background: var(--gray-100);
    border-radius: 4px;
}

.patients-grid::-webkit-scrollbar-thumb {
    background: var(--gray-300);
    border-radius: 4px;
}

.patients-grid::-webkit-scrollbar-thumb:hover {
    background: var(--gray-400);
}
</style>

<div class="main-content">
    <!-- Page Header -->
    <div class="page-header">
        <div class="page-title-section">
            <div>
                <h1 class="page-title">سجل المرضى</h1>
                <p class="page-subtitle">إدارة ومتابعة جميع المرضى المسجلين في العيادة</p>
            </div>
            <div class="page-actions">
                <a href="/patient/add" class="btn btn-primary">
                    <ion-icon name="person-add"></ion-icon>
                    <span>مريض جديد</span>
                </a>
            </div>
        </div>

        <!-- Stats Bar -->
        <div class="stats-bar">
            <div class="stat-item">
                <div class="stat-icon">
                    <ion-icon name="people"></ion-icon>
                </div>
                <div class="stat-content">
                    <div class="stat-value" id="totalPatients">0</div>
                    <div class="stat-label">إجمالي المرضى</div>
                </div>
            </div>
            <div class="stat-item">
                <div class="stat-icon">
                    <ion-icon name="pulse"></ion-icon>
                </div>
                <div class="stat-content">
                    <div class="stat-value" id="activePatients">0</div>
                    <div class="stat-label">مرضى نشطين</div>
                </div>
            </div>
            <div class="stat-item">
                <div class="stat-icon">
                    <ion-icon name="calendar"></ion-icon>
                </div>
                <div class="stat-content">
                    <div class="stat-value" id="newThisMonth">0</div>
                    <div class="stat-label">جدد هذا الشهر</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Patients Section -->
    <div class="patients-section">
        <!-- Header with Search -->
        <div class="patients-header">
            <div class="patients-title-section">
                <h2 class="patients-header-title">سجل المرضى</h2>
                <span class="patients-count" id="patientsCount">0 مريض</span>
            </div>

            <!-- Search Bar -->
            <div class="search-bar">
                <div class="search-input-wrapper">
                    <input type="text" class="search-input" id="searchInput" placeholder="ابحث بالاسم، الهاتف، أو الكود..." autocomplete="off" oninput="handleSearch(this.value)">
                    <ion-icon class="search-icon" name="search"></ion-icon>
                    <button class="clear-search" id="clearSearch" onclick="clearSearchInput()">
                        <ion-icon name="close"></ion-icon>
                    </button>
                </div>
                <div class="search-filters">
                    <button class="filter-chip active" data-filter="all">
                        <ion-icon name="apps"></ion-icon>
                        الكل
                    </button>
                    <button class="filter-chip" data-filter="active">
                        <ion-icon name="pulse"></ion-icon>
                        نشطين
                    </button>
                    <button class="filter-chip" data-filter="inactive">
                        <ion-icon name="stop-circle"></ion-icon>
                        غير نشطين
                    </button>
                </div>
            </div>
            <p class="search-hint">
                💡 اكتب للبحث الفوري • يدعم الأخطاء الإملائية • اضغط <kbd>Esc</kbd> لمسح البحث
            </p>
        </div>

        <!-- Loading State -->
        <div class="loading-state" id="loadingState">
            <div class="spinner"></div>
            <p class="loading-text">جاري البحث...</p>
        </div>

        <!-- Patients Grid -->
        <div class="patients-content">
            <div class="patients-grid" id="patientsGrid">
                <!-- Patients will be loaded here -->
            </div>
        </div>
    </div>
</div>

<script>
// Patient data from server
const patientsData = <%- JSON.stringify(data) %>;

// Debug: Check if data is loaded
console.log('Patients loaded:', patientsData ? patientsData.length : 0, 'patients');

// State
let currentFilter = 'all';
let searchQuery = '';
let filteredPatients = [...patientsData];
let fuse = null;

// Initialize Fuse.js for fuzzy search
if (typeof Fuse !== 'undefined' && patientsData && patientsData.length > 0) {
    fuse = new Fuse(patientsData, {
        keys: [
            { name: 'name', weight: 0.7 },
            { name: 'phone', weight: 0.2 },
            { name: 'code', weight: 0.1 }
        ],
        threshold: 0.4,
        distance: 100,
        minMatchCharLength: 1,
        includeScore: false
    });
    console.log('Fuse.js initialized');
} else {
    console.error('Fuse.js not loaded or no patients data');
}

// Global search handler - called by inline oninput
window.handleSearch = function(value) {
    const query = value.trim();
    searchQuery = query;
    const clearButton = document.getElementById('clearSearch');

    console.log('handleSearch called with:', query);

    // Show/hide clear button
    if (query.length > 0) {
        clearButton.classList.add('visible');
    } else {
        clearButton.classList.remove('visible');
    }

    // Instant search
    if (query.length === 0) {
        filteredPatients = [...patientsData];
    } else if (fuse) {
        const results = fuse.search(query);
        console.log('Search results:', results.length);
        filteredPatients = results.map(result => result.item);
    } else {
        // Fallback
        filteredPatients = patientsData.filter(patient => {
            const lowerQuery = query.toLowerCase();
            return (patient.name && patient.name.toLowerCase().includes(lowerQuery)) ||
                   (patient.phone && patient.phone.includes(query)) ||
                   (patient.code && String(patient.code).includes(query));
        });
    }

    applyFilter();
};

// Global clear search handler
window.clearSearchInput = function() {
    const searchInput = document.getElementById('searchInput');
    searchInput.value = '';
    searchQuery = '';
    document.getElementById('clearSearch').classList.remove('visible');
    filteredPatients = [...patientsData];
    applyFilter();
    searchInput.focus();
};

// Initialize
document.addEventListener('DOMContentLoaded', () => {
    console.log('DOM loaded, initializing...');
    renderPatients(patientsData);
    updateStats(patientsData);
    setupFilters();
    setupKeyboardShortcuts();
    // Don't call setupSearch anymore since we use inline handlers
});

// Render patients grid
function renderPatients(patients) {
    const grid = document.getElementById('patientsGrid');
    const countEl = document.getElementById('patientsCount');

    console.log('Rendering patients:', patients.length);

    if (patients.length === 0) {
        grid.innerHTML = `
            <div class="empty-state" style="grid-column: 1 / -1;">
                <ion-icon class="empty-state-icon" name="people-outline"></ion-icon>
                <div class="empty-state-title">${searchQuery ? 'لا توجد نتائج' : 'لا يوجد مرضى'}</div>
                <div class="empty-state-text">${searchQuery ? 'لم يتم العثور على مرضى مطابقين لبحثك' : 'لم يتم إضافة أي مرضى بعد'}</div>
            </div>
        `;
        countEl.textContent = '0 مريض';
        return;
    }

    countEl.textContent = `${patients.length} مريض`;

    grid.innerHTML = patients.map((patient) => {
        const initials = getInitials(patient.name);
        const isActive = patient.inCourse === true;
        const statusTag = isActive ? 'tag-active' : 'tag-inactive';
        const statusText = isActive ? 'نشط' : 'غير نشط';

        return `
            <div class="patient-card" onclick="window.location.href='/patient/get-by-id/${patient._id}'">
                <div class="patient-card-header">
                    <div class="patient-avatar">${initials}</div>
                    <div class="patient-info">
                        <div class="patient-name">${patient.name}</div>
                        <div class="patient-meta">
                            ${patient.phone ? `
                                <span class="patient-meta-item">
                                    <ion-icon name="call-outline"></ion-icon>
                                    ${patient.phone}
                                </span>
                            ` : ''}
                        </div>
                    </div>
                </div>
                <div class="patient-card-body">
                    <span class="patient-tag tag-code">
                        <ion-icon name="hash"></ion-icon>
                        ${patient.code || 'N/A'}
                    </span>
                    ${patient.dateAdded ? `
                        <span class="patient-tag tag-date">
                            <ion-icon name="calendar-outline"></ion-icon>
                            ${patient.dateAdded}
                        </span>
                    ` : ''}
                    <span class="patient-tag ${statusTag}">
                        <ion-icon name="${isActive ? 'pulse' : 'stop-circle-outline'}"></ion-icon>
                        ${statusText}
                    </span>
                </div>
            </div>
        `;
    }).join('');
}

// Update statistics
function updateStats(patients) {
    const total = patients.length;
    const active = patients.filter(p => p.inCourse === true).length;

    // Calculate new patients this month
    const now = new Date();
    const thisMonth = now.getMonth();
    const thisYear = now.getFullYear();
    const newPatients = patients.filter(p => {
        if (!p.dateAdded) return false;
        try {
            const dateAdded = parseArabicDate(p.dateAdded);
            return dateAdded.getMonth() === thisMonth && dateAdded.getFullYear() === thisYear;
        } catch {
            return false;
        }
    }).length;

    // Animate numbers
    animateNumber('totalPatients', total);
    animateNumber('activePatients', active);
    animateNumber('newThisMonth', newPatients);
}

// Animate number counting
function animateNumber(elementId, target) {
    const element = document.getElementById(elementId);
    if (!element) return;

    const duration = 1000;
    const steps = 30;
    const stepValue = target / steps;
    let current = 0;
    let step = 0;

    const timer = setInterval(() => {
        step++;
        current = Math.round(stepValue * step);
        if (step >= steps) {
            current = target;
            clearInterval(timer);
        }
        element.textContent = current.toLocaleString('ar-EG');
    }, duration / steps);
}

// Parse Arabic date
function parseArabicDate(arabicDate) {
    if (!arabicDate) return new Date();

    // Handle various date formats
    const parts = arabicDate.split('/');
    if (parts.length === 3) {
        // DD/MM/YYYY format
        return new Date(parts[2], parts[1] - 1, parts[0]);
    }

    return new Date(arabicDate);
}

// Get initials from name
function getInitials(name) {
    const words = name.trim().split(' ');
    if (words.length === 1) {
        return words[0].charAt(0);
    }
    return (words[0].charAt(0) + words[words.length - 1].charAt(0)).toUpperCase();
}

// Setup filter buttons
function setupFilters() {
    const filterChips = document.querySelectorAll('.filter-chip');

    filterChips.forEach(chip => {
        chip.addEventListener('click', () => {
            // Update active state
            filterChips.forEach(c => c.classList.remove('active'));
            chip.classList.add('active');

            // Update filter
            currentFilter = chip.dataset.filter;
            applyFilter();
        });
    });
}

// Apply current filter
function applyFilter() {
    let results = [...filteredPatients];

    switch (currentFilter) {
        case 'active':
            results = results.filter(p => p.inCourse === true);
            break;
        case 'inactive':
            results = results.filter(p => p.inCourse !== true);
            break;
        default:
            // Show all
            break;
    }

    renderPatients(results);
    updateStats(results);
}

// Setup keyboard shortcuts
function setupKeyboardShortcuts() {
    document.addEventListener('keydown', (e) => {
        // Escape: Clear search
        if (e.key === 'Escape') {
            const searchInput = document.getElementById('searchInput');
            if (searchInput.value.length > 0) {
                clearSearchInput();
            }
        }

        // Slash: Focus search (when not in input)
        if (e.key === '/' && document.activeElement.tagName !== 'INPUT') {
            e.preventDefault();
            document.getElementById('searchInput').focus();
        }

        // Ctrl/Cmd + N: New patient
        if ((e.metaKey || e.ctrlKey) && e.key === 'n') {
            e.preventDefault();
            window.location.href = '/patient/add';
        }
    });
}
</script>

