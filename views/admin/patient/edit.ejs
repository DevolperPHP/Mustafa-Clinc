<%- include('../../layout/sidebar-start') -%>

<style>
    :root {
        --primary: #22C55E;
        --primary-dark: #16a34a;
        --primary-light: rgba(34, 197, 94, 0.1);
        --danger: #ef4444;
        --warning: #f59e0b;
        --info: #3b82f6;
        --success: #10b981;
        --dark: #1f2937;
        --light: #f9fafb;
        --gray: #6b7280;
        --gray-light: #e5e7eb;
        --shadow: rgba(0, 0, 0, 0.1);
        --shadow-lg: rgba(0, 0, 0, 0.15);
    }

    .edit-container {
        max-width: 900px;
        margin: 0 auto;
        padding: 30px 20px 100px 20px;
        direction: rtl;
    }

    /* Header */
    .edit-header {
        text-align: center;
        margin-bottom: 40px;
    }

    .edit-header h1 {
        font-size: 28px;
        font-weight: 800;
        color: var(--dark);
        margin: 0 0 8px 0;
    }

    .edit-header p {
        font-size: 16px;
        color: var(--gray);
        margin: 0;
    }

    /* Patient Summary Card */
    .patient-summary {
        background: linear-gradient(135deg, var(--primary), var(--primary-dark));
        color: white;
        padding: 24px 32px;
        border-radius: 16px;
        margin-bottom: 30px;
        box-shadow: 0 10px 30px var(--shadow-lg);
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .patient-avatar {
        width: 70px;
        height: 70px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        font-weight: 700;
        flex-shrink: 0;
    }

    .patient-summary-info h2 {
        font-size: 20px;
        font-weight: 700;
        margin: 0 0 6px 0;
    }

    .patient-summary-info p {
        font-size: 14px;
        opacity: 0.9;
        margin: 0;
    }

    /* Form Card */
    .form-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 20px var(--shadow);
        overflow: hidden;
        border: 1px solid var(--gray-light);
        margin-bottom: 24px;
    }

    .form-card-header {
        padding: 20px 28px;
        background: linear-gradient(135deg, #f8fafc, #f1f5f9);
        border-bottom: 1px solid var(--gray-light);
    }

    .form-card-header h3 {
        font-size: 18px;
        font-weight: 700;
        color: var(--dark);
        margin: 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .form-card-header h3 ion-icon {
        font-size: 24px;
        color: var(--primary);
    }

    .form-card-body {
        padding: 28px;
    }

    /* Form Grid */
    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    .form-grid.full-width {
        grid-template-columns: 1fr;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .form-group.full-width {
        grid-column: 1 / -1;
    }

    .form-label {
        font-size: 14px;
        font-weight: 600;
        color: var(--dark);
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .form-label ion-icon {
        font-size: 18px;
        color: var(--primary);
    }

    .form-input,
    .form-select,
    .form-textarea {
        width: 100%;
        padding: 14px 18px;
        border: 2px solid var(--gray-light);
        border-radius: 12px;
        font-size: 15px;
        font-family: 'Tajawal', sans-serif;
        direction: rtl;
        transition: all 0.3s ease;
        background: white;
    }

    .form-input:focus,
    .form-select:focus,
    .form-textarea:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.1);
    }

    .form-textarea {
        resize: vertical;
        min-height: 100px;
    }

    /* Autocomplete Styles */
    .autocomplete {
        position: relative;
    }

    .autocomplete-items {
        position: absolute;
        border: 1px solid var(--gray-light);
        border-radius: 8px;
        z-index: 99;
        top: 100%;
        left: 0;
        right: 0;
        max-height: 300px;
        overflow-y: auto;
        background: white;
        box-shadow: 0 4px 20px var(--shadow-lg);
        margin-top: 4px;
    }

    .autocomplete-items div {
        padding: 12px 16px;
        cursor: pointer;
        border-bottom: 1px solid var(--gray-light);
        font-size: 14px;
        direction: rtl;
    }

    .autocomplete-items div:last-child {
        border-bottom: none;
    }

    .autocomplete-items div:hover,
    .autocomplete-active {
        background: #f0fdf4;
    }

    .autocomplete-items strong {
        color: var(--primary);
    }

    /* Form Actions */
    .form-actions {
        display: flex;
        gap: 16px;
        margin-top: 32px;
    }

    .btn {
        flex: 1;
        padding: 16px 32px;
        border: none;
        border-radius: 12px;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        transition: all 0.3s ease;
        text-decoration: none;
        direction: rtl;
    }

    .btn ion-icon {
        font-size: 24px;
    }

    .btn-primary {
        background: linear-gradient(135deg, var(--success), #059669);
        color: white;
        box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3);
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(16, 185, 129, 0.4);
    }

    .btn-secondary {
        background: var(--gray-light);
        color: var(--dark);
    }

    .btn-secondary:hover {
        background: #d1d5db;
    }

    /* Responsive */
    @media (max-width: 768px) {
        .edit-container {
            padding: 20px 16px 80px 16px;
        }

        .edit-header h1 {
            font-size: 22px;
        }

        .patient-summary {
            flex-direction: column;
            text-align: center;
            padding: 20px;
        }

        .form-grid {
            grid-template-columns: 1fr;
        }

        .form-card-body {
            padding: 20px;
        }

        .form-actions {
            flex-direction: column;
        }

        .form-input,
        .form-select,
        .form-textarea {
            font-size: 14px;
            padding: 12px 16px;
        }
    }

    /* Animations */
    @keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .form-card {
        animation: fadeIn 0.4s ease;
    }

    .form-card:nth-child(2) {
        animation-delay: 0.1s;
    }

    .form-card:nth-child(3) {
        animation-delay: 0.2s;
    }

    .form-card:nth-child(4) {
        animation-delay: 0.3s;
    }

    /* Section Badge */
    .section-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 12px;
        background: var(--primary-light);
        color: var(--primary-dark);
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        margin-right: auto;
    }

    /* Required Indicator */
    .required {
        color: var(--danger);
        margin-right: 4px;
    }

    /* Input Icon Wrapper */
    .input-wrapper {
        position: relative;
    }

    .input-wrapper ion-icon {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 20px;
        color: var(--gray);
        pointer-events: none;
    }

    .input-wrapper .form-input,
    .input-wrapper .form-select {
        padding-left: 44px;
    }
</style>

<div class="edit-container">
    <!-- Header -->
    <div class="edit-header">
        <h1>تعديل معلومات المريض</h1>
        <p>تحديث البيانات الشخصية والطبية</p>
    </div>

    <!-- Patient Summary -->
    <div class="patient-summary">
        <div class="patient-avatar">
            <%= data.name.charAt(0) %>
        </div>
        <div class="patient-summary-info">
            <h2><%= data.name %></h2>
            <p>كود المريض: #<%= data.code %> • <%= data.phone %></p>
        </div>
    </div>

    <!-- Edit Form -->
    <form action="/patient/edit-profile/<%= data._id %>?_method=PUT" method="post">
        <!-- Personal Information -->
        <div class="form-card">
            <div class="form-card-header">
                <h3>
                    <ion-icon name="person-outline"></ion-icon>
                    المعلومات الشخصية
                    <span class="section-badge">أساسي</span>
                </h3>
            </div>
            <div class="form-card-body">
                <div class="form-grid">
                    <div class="form-group full-width">
                        <label class="form-label">
                            <ion-icon name="person"></ion-icon>
                            الاسم الكامل
                            <span class="required">*</span>
                        </label>
                        <div class="input-wrapper">
                            <input type="text" name="name" class="form-input" value="<%= data.name %>" required>
                            <ion-icon name="create-outline"></ion-icon>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <ion-icon name="calendar"></ion-icon>
                            تاريخ الميلاد
                            <span class="required">*</span>
                        </label>
                        <input type="date" name="birthDate" class="form-input" value="<%= data.birthDate %>" required>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <ion-icon name="male-female"></ion-icon>
                            الجنس
                            <span class="required">*</span>
                        </label>
                        <select name="gender" class="form-select" required>
                            <option value="<%= data.gender %>" selected><%= data.gender %></option>
                            <option>ذكر</option>
                            <option>انثى</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <ion-icon name="call"></ion-icon>
                            رقم الهاتف
                            <span class="required">*</span>
                        </label>
                        <div class="input-wrapper">
                            <input type="text" name="phone" class="form-input" value="<%= data.phone %>" required>
                            <ion-icon name="call-outline"></ion-icon>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <ion-icon name="home"></ion-icon>
                            العنوان
                        </label>
                        <div class="input-wrapper">
                            <input type="text" name="address" class="form-input" value="<%= data.address %>">
                            <ion-icon name="location-outline"></ion-icon>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Education & Social Information -->
        <div class="form-card">
            <div class="form-card-header">
                <h3>
                    <ion-icon name="school-outline"></ion-icon>
                    التعليم والحالة الاجتماعية
                </h3>
            </div>
            <div class="form-card-body">
                <div class="form-grid">
                    <div class="form-group">
                        <label class="form-label">
                            <ion-icon name="book"></ion-icon>
                            المستوى التعليمي
                        </label>
                        <select name="study" class="form-select">
                            <option value="<%= data.study %>" selected><%= data.study %></option>
                            <option>يقرا و يكتب</option>
                            <option>ابتدائي</option>
                            <option>متوسط</option>
                            <option>ثانوي</option>
                            <option>دبلوم</option>
                            <option>بكلوريوس</option>
                            <option>ماجستير</option>
                            <option>دكتوراة</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <ion-icon name="heart"></ion-icon>
                            الحالة الاجتماعية
                        </label>
                        <select name="relationship" class="form-select">
                            <option value="<%= data.relationship %>" selected><%= data.relationship %></option>
                            <option>اعزب</option>
                            <option>متزوج</option>
                            <option>ارمل</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <ion-icon name="people"></ion-icon>
                            عدد أفراد العائلة
                        </label>
                        <input type="number" name="familyMembers" class="form-input" value="<%= data.familyMembers %>" min="1">
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <ion-icon name="swap-horizontal"></ion-icon>
                            التسلسل في العائلة
                        </label>
                        <input type="number" name="familyRank" class="form-input" value="<%= data.familyRank %>" min="1">
                    </div>
                </div>
            </div>
        </div>

        <!-- Health Status -->
        <div class="form-card">
            <div class="form-card-header">
                <h3>
                    <ion-icon name="medkit-outline"></ion-icon>
                    الحالة الصحية والنفسية
                </h3>
            </div>
            <div class="form-card-body">
                <div class="form-grid">
                    <div class="form-group">
                        <label class="form-label">
                            <ion-icon name="fitness"></ion-icon>
                            الحالة الصحية
                        </label>
                        <select name="health" class="form-select">
                            <option value="<%= data.health %>" selected><%= data.health %></option>
                            <option>جيد</option>
                            <option>متوسط</option>
                            <option>ضعيف</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <ion-icon name="happy"></ion-icon>
                            الحالة النفسية
                        </label>
                        <select name="psycho" class="form-select">
                            <option value="<%= data.psycho %>" selected><%= data.psycho %></option>
                            <option>جيد</option>
                            <option>متوسط</option>
                            <option>ضعيف</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <ion-icon name="people-circle"></ion-icon>
                            العلاقات الأسرية
                        </label>
                        <select name="RelationshipAndFamily" class="form-select">
                            <option value="<%= data.RelationshipAndFamily %>" selected><%= data.RelationshipAndFamily %></option>
                            <option>جيد</option>
                            <option>متوسط</option>
                            <option>ضعيف</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <ion-icon name="arrow-forward"></ion-icon>
                            الإحالة إلى
                        </label>
                        <input type="text" name="sendTo" class="form-input" value="<%= data.sendTo %>" placeholder="اسم الطبيب أو المركز">
                    </div>
                </div>
            </div>
        </div>

        <!-- Diagnosis -->
        <div class="form-card">
            <div class="form-card-header">
                <h3>
                    <ion-icon name="document-text-outline"></ion-icon>
                    التشخيص
                    <span class="section-badge">طبي</span>
                </h3>
            </div>
            <div class="form-card-body">
                <div class="form-grid full-width">
                    <div class="form-group">
                        <label class="form-label">
                            <ion-icon name="stethoscope"></ion-icon>
                            تشخيص المعالج
                        </label>
                        <div class="autocomplete">
                            <input type="text" name="therapist_diagnose" id="myInput" class="form-input" placeholder="ابدأ الكتابة للبحث..." value="<%= data.therapist_diagnose %>">
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <ion-icon name="medkit"></ion-icon>
                            تشخيص الطبيب
                        </label>
                        <div class="autocomplete">
                            <input type="text" name="doctor_diagnose" id="myInput2" class="form-input" placeholder="ابدأ الكتابة للبحث..." value="<%= data.doctor_diagnose %>">
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Notes -->
        <div class="form-card">
            <div class="form-card-header">
                <h3>
                    <ion-icon name="create-outline"></ion-icon>
                    الملاحظات
                </h3>
            </div>
            <div class="form-card-body">
                <div class="form-grid full-width">
                    <div class="form-group">
                        <label class="form-label">
                            <ion-icon name="chatbubble"></ion-icon>
                            ملاحظات نفسية
                        </label>
                        <textarea name="psychoNote" class="form-textarea" placeholder="أضف ملاحظات حول الحالة النفسية للمريض..."><%= data.psychoNote %></textarea>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <ion-icon name="pill"></ion-icon>
                            الأدوية المستخدمة
                        </label>
                        <textarea name="Notes" class="form-textarea" placeholder="أدخل الأدوية الحالية..."><%= data.Notes %></textarea>
                    </div>
                </div>
            </div>
        </div>

        <!-- Form Actions -->
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">
                <ion-icon name="checkmark-circle"></ion-icon>
                حفظ التغييرات
            </button>
            <a href="/patient/get-by-id/<%= data._id %>" class="btn btn-secondary">
                <ion-icon name="close-circle"></ion-icon>
                إلغاء
            </a>
        </div>
    </form>
</div>

<script src="https://cdn.jsdelivr.net/npm/fuse.js@6.6.2"></script>
<script>
    function autocomplete(inp, arr) {
        let currentFocus;
        const fuse = new Fuse(arr, {
            threshold: 0.4,
        });

        inp.addEventListener("input", function () {
            let a, b, val = this.value;
            closeAllLists();
            if (!val) return false;
            currentFocus = -1;

            a = document.createElement("DIV");
            a.setAttribute("id", this.id + "autocomplete-list");
            a.setAttribute("class", "autocomplete-items");
            this.parentNode.appendChild(a);

            const results = fuse.search(val);
            results.forEach(({ item }) => {
                b = document.createElement("DIV");
                b.innerHTML = `<strong>${item.substr(0, val.length)}</strong>${item.substr(val.length)}`;
                b.innerHTML += `<input type='hidden' value='${item}'>`;
                b.addEventListener("click", function () {
                    inp.value = this.getElementsByTagName("input")[0].value;
                    closeAllLists();
                });
                a.appendChild(b);
            });
        });

        inp.addEventListener("keydown", function (e) {
            let x = document.getElementById(this.id + "autocomplete-list");
            if (x) x = x.getElementsByTagName("div");
            if (e.keyCode == 40) {
                currentFocus++;
                addActive(x);
            } else if (e.keyCode == 38) {
                currentFocus--;
                addActive(x);
            } else if (e.keyCode == 13) {
                e.preventDefault();
                if (currentFocus > -1 && x) x[currentFocus].click();
            }
        });

        function addActive(x) {
            if (!x) return false;
            removeActive(x);
            if (currentFocus >= x.length) currentFocus = 0;
            if (currentFocus < 0) currentFocus = x.length - 1;
            x[currentFocus].classList.add("autocomplete-active");
        }

        function removeActive(x) {
            for (let i = 0; i < x.length; i++) {
                x[i].classList.remove("autocomplete-active");
            }
        }

        function closeAllLists(elmnt) {
            const x = document.getElementsByClassName("autocomplete-items");
            for (let i = 0; i < x.length; i++) {
                if (elmnt != x[i] && elmnt != inp) {
                    x[i].parentNode.removeChild(x[i]);
                }
            }
        }

        document.addEventListener("click", function (e) {
            closeAllLists(e.target);
        });
    }

